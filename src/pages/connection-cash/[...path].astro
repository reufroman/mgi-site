---
import '../../styles/site.css';
import site from '../../data/site.json';
import {review} from '../../data/catalog.mjs';
// Emit this draft only in review mode. Noindex alone is not a publication gate.
export function getStaticPaths(){return review?[{params:{path:undefined}}]:[];}
// Single editable reward block. Source: Jesse's Connection Cash Program 2026.pdf,
// Gmail thread 1a1793d39c5bb5c6. Public use and missing terms remain held.
const rewards=[{purchase:'$10,000 to $19,999',reward:'$200'},{purchase:'$20,000 or more',reward:'$300'}];
const phoneHref='tel:+1'+site.phone.replace(/[^0-9]/g,'');
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="robots" content="noindex, nofollow"/><title>Connection Cash, review draft | MGI Heating and Air</title><link rel="icon" href="/assets/mgi-badge.png"/></head>
<body><a class="skip" href="#main">Skip to content</a>
<aside class="draft">Review draft for Jesse. Not live. Program terms still need confirmation.</aside>
<header><a href="/" aria-label="MGI Heating and Air home"><img src="/assets/mgi-badge-240.webp" alt="MGI Heating and Air" width="104" height="104"/></a><a class="phone" href={phoneHref}>{site.phone}</a></header>
<main id="main"><section class="intro"><p class="eyebrow">MGI Heating and Air</p><h1>Connection Cash</h1><p>Connect a friend or family member with MGI Heating and Air. When MGI installs their new heating and/or cooling system, the program sheet lists these rewards for you.</p>
<div class="rewards" aria-label="Connection Cash rewards">{rewards.map(item=><div><span>New system purchase</span><p>{item.purchase}</p><strong>{item.reward}</strong><span>for the person who referred them</span></div>)}</div>
<p class="source">Amounts from MGI's Connection Cash Program 2026 sheet, supplied October 26, 2026. Review as of November 2, 2026.</p></section>
<section class="next"><h2>Want to make a connection?</h2><ol><li><strong>Start with MGI.</strong> Call to ask how to submit the referral.</li><li><strong>Have the details ready.</strong> The program sheet asks for your name, address, phone, and email, plus those details for the person you refer. Ask their permission before sharing.</li><li><strong>Check the terms first.</strong> Confirm what qualifies and when the reward is paid with MGI.</li></ol>
<div class="actions"><a class="button" href={phoneHref}>Call {site.phone}</a><a class="button outline" href="/schedule-service/">Request service</a></div><p class="request-note">A service request is not a referral submission or a confirmed appointment. Call MGI about the referral.</p></section>
<aside class="review-terms"><h2>Jesse, still to confirm before publication</h2><p>How to submit the referral, who qualifies, when the reward is paid, any deadline, and whether discounts or other limits apply. The supplied sheet does not state these terms.</p></aside>
</main><footer>MGI Heating and Air, a brand of MGI Mechanical Services Inc. <a href="/privacy-policy/">Privacy policy</a></footer>
</body></html>
<style>
:global(body){background:#f4f4ed;color:#1a1a1a}.draft{background:#e8edcf;padding:10px 20px;text-align:center;font-size:13px}header{max-width:1050px;margin:auto;padding:20px 28px;display:flex;justify-content:space-between;align-items:center}header img{display:block}.phone{color:#174e5b;font-weight:700;font-size:18px;padding:12px 0}main{max-width:980px;margin:auto;padding:0 28px}.intro{max-width:800px;margin:auto;text-align:center}.eyebrow{color:#174e5b;font-size:12px;letter-spacing:.12em;text-transform:uppercase;font-weight:700;margin:12px auto}h1{font-size:clamp(40px,5vw,64px);line-height:1.03;color:#174e5b;margin:12px 0 22px}.intro>p{margin:0 auto 20px;max-width:64ch;font-size:17px;line-height:1.6}.rewards{display:grid;grid-template-columns:1fr 1fr;gap:20px;text-align:left}.rewards>div{padding:24px;background:#fffdfb;border:1px solid #b8c4a2;border-radius:12px}.rewards span{display:block;font-size:13px;color:#484b47}.rewards p{font-weight:700;font-size:20px;margin:8px 0}.rewards strong{display:block;font:600 52px/1.1 Cormorant,Georgia,serif;color:#174e5b;margin-bottom:8px}.intro>.source{font-size:12px;line-height:1.6;margin:16px auto 0}.next{padding:48px 0 32px;max-width:760px;margin:auto}h2{color:#174e5b;font-size:34px;line-height:1.15}ol{padding-left:24px}li{padding:0 0 18px 4px;font-size:17px;line-height:1.65}li strong{display:block}.actions{display:flex;gap:16px;flex-wrap:wrap}.request-note{font-size:13px;line-height:1.65;margin-top:16px}.review-terms{background:#fffdfb;border-left:4px solid #7b8e36;padding:24px;margin:0 0 32px}.review-terms h2{font-size:25px;margin:0 0 12px}.review-terms p{font-size:15px;line-height:1.65;margin:0}footer{max-width:980px;margin:auto;padding:24px 28px;font-size:13px;color:#484b47}footer a{margin-left:12px;color:inherit}a:focus-visible{outline:3px solid #174e5b;outline-offset:4px}@media(max-width:600px){header{padding:12px 20px}header img{width:84px;height:84px}.phone{font-size:16px}main{padding:0 20px}.intro{text-align:left}h1{font-size:42px}.intro>p{font-size:16px}.rewards{gap:12px}.rewards>div{padding:16px 12px}.rewards p{font-size:17px}.rewards strong{font-size:44px}.rewards span{font-size:12px}.intro>.source{font-size:11px}.next{padding-top:32px}h2{font-size:30px}.actions{flex-direction:column}.actions a{justify-content:center}.review-terms{padding:20px}footer{padding:20px}}
</style>
