---
// Copies the site header and footer without importing catalog.mjs.
// That module loads the external answer library as soon as it is imported.
import '../styles/site.css';
import LandingCallMeasurement from '../components/LandingCallMeasurement.astro';
import ReadingMotion from '../components/ReadingMotion.astro';
import ServiceTitanScheduler from '../components/ServiceTitanScheduler.astro';
import ServiceIcon from '../components/ServiceIcon.astro';
import CredentialLogos from '../components/CredentialLogos.astro';
import site from '../data/site.json';
import proof from '../data/home-proof.json';
import routes from '../data/routes.json';
import {scheduleHref} from '../data/holiday-specials.mjs';

const buildMode = process.env.MGI_BUILD_MODE || 'review';
const review = buildMode === 'review';
const byId = (id: string) => routes.find(route => route.page_id === id);
const areas = routes.filter(route => route.family === 'Area');
const navigation = [['ST-005','Services'],['ST-006','Service areas'],['ST-007','Financing'],['ST-008','Rebates'],['ST-079','Emergency']].filter(([id]) => byId(id));
const resources = [['ST-012','Homeowner help'],['ST-002','About']].filter(([id]) => byId(id));
const phone = site.phone ? String(site.phone) : '';
const dial = phone.replace(/[^+0-9]/g, '');
const phoneHref = 'tel:' + (dial.length === 10 ? '+1' : '') + dial;
const canonical = new URL('/specials/', Astro.site).href;
const description = 'Holiday offers through December 30, 2026. Includes a $99 furnace tune-up, $150 off an installed humidifier, 0% APR financing for 72 months with equal payments, and stacked utility rebates.';
const robots = review ? 'noindex, nofollow' : 'index, follow';
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>Holiday specials | MGI Heating and Air</title>
<meta name="description" content={description}/>
<meta name="robots" content={robots}/>
<link rel="canonical" href={canonical}/>
<meta name="theme-color" content="#174E5B"/>
<link rel="preload" href="/assets/manrope.woff2" as="font" type="font/woff2" crossorigin/>
<link rel="preload" href="/assets/cormorant.woff2" as="font" type="font/woff2" crossorigin/>
<meta property="og:title" content="Holiday specials | MGI Heating and Air"/>
<meta property="og:description" content={description}/>
<meta property="og:type" content="website"/>
<meta property="og:site_name" content={site.brand}/>
<meta property="og:locale" content="en_US"/>
<meta property="og:url" content={canonical}/>
<meta property="og:image" content={new URL('/assets/mgi-badge.png', Astro.site).href}/>
<meta property="og:image:alt" content="MGI Heating and Air logo"/>
<meta name="twitter:card" content="summary"/>
<link rel="icon" href="/assets/mgi-badge.png" type="image/png"/>
</head>
<body data-page-id="HOLIDAY-SPECIALS" data-build-mode={buildMode}>
<a class="skip" href="#main">Skip to content</a>
<LandingCallMeasurement sitewide/>
{review && <div class="review-bar"><strong>Private review</strong><span>Draft site. The scheduler sends real requests.</span><a href="/review/">Page directory</a></div>}
<header class="site-header">
  <div class="wrap masthead">
    <nav class="desktop-nav" aria-label="Main navigation">
      {navigation.map(([id, label]) => <a href={byId(id)!.canonical_route}>{label}</a>)}
    </nav>
    <a class="brand" href="/" aria-label="MGI Heating and Air home"><img src="/assets/mgi-badge-240.webp" srcset="/assets/mgi-badge-120.webp 120w, /assets/mgi-badge-240.webp 240w" sizes="120px" alt="MGI Heating and Air" width="667" height="667"/></a>
    <div class="header-right">
      <details class="header-help desktop-nav">
        <summary>More</summary>
        <nav aria-label="More navigation">
          {resources.map(([id, label]) => <a href={byId(id)!.canonical_route}>{label}</a>)}
          <a href="/specials/" aria-current="page">Specials</a>
        </nav>
      </details>
      {phone && <a class="button small outline phone-button" aria-label={`Call MGI at ${phone}`} href={phoneHref}><ServiceIcon name="phone"/><span>{phone}</span></a>}
      <a class="button small schedule-button" href={scheduleHref}>Schedule service</a>
    </div>
    <details class="mobile-menu">
      <summary>Menu</summary>
      <nav aria-label="Mobile navigation">
        {navigation.map(([id, label]) => <a href={byId(id)!.canonical_route}>{label}</a>)}
        {resources.map(([id, label]) => <a href={byId(id)!.canonical_route}>{label}</a>)}
        <a href="/specials/" aria-current="page">Specials</a>
        <a href={scheduleHref}>Schedule service</a>
        {phone && <a href={phoneHref}>Call {phone}</a>}
      </nav>
    </details>
  </div>
</header>
<main id="main" tabindex="-1"><slot/></main>
<ReadingMotion/>
<footer class="site-footer">
  <div class="wrap">
    <div class="footer-top">
      <div><p class="footer-name">MGI Heating and Air</p><p>Heating and cooling help for your home.</p></div>
      <a href={proof.carrier}><img class="carrier-logo" src="/assets/carrier-logo.png" alt="Carrier" width="800" height="320"/></a>
    </div>
    <div class="footer-grid">
      <div>
        <h3>Let’s talk.</h3>
        {phone && <p><a class="footer-phone" href={phoneHref}>{phone}</a></p>}
        <p>{site.address}</p>
        <a class="button" href={scheduleHref}>Schedule service ↗</a>
        <div class="footer-credentials"><CredentialLogos compact/></div>
      </div>
      <nav aria-label="Footer services">
        <h3>Services</h3>
        {['ST-020','ST-021','ST-022','ST-023','ST-024','ST-026','ST-025','ST-027','ST-079'].filter(id => byId(id)).map(id => <a href={byId(id)!.canonical_route}>{byId(id)!.name}</a>)}
      </nav>
      <nav aria-label="Footer service areas">
        <h3>Our communities</h3>
        {areas.filter(area => !['Fort Collins','Johnstown','Timnath','Severance','Dacono'].includes(area.name.replace('HVAC Services in ',''))).map(area => <a href={area.canonical_route}>{area.name.replace('HVAC Services in ','')}</a>)}
        <a href="/service-area/">All service areas ↗</a>
      </nav>
      <nav aria-label="Footer resources">
        <h3>Homeowner help</h3>
        <a href="/specials/" aria-current="page">Specials</a>
        {['ST-007','ST-008','ST-010','ST-011','ST-012','ST-013','ST-002','ST-003'].filter(id => byId(id)).map(id => <a href={byId(id)!.canonical_route}>{byId(id)!.name}</a>)}
      </nav>
    </div>
    <p class="footer-coverage">Contact MGI to confirm service at your address and current availability.</p>
    <div class="footer-bottom">
      <small>© 2026 {site.legalName}</small>
      <nav aria-label="Policies">{['MIGRATION-FAQ','ST-014','ST-015','ST-016','ST-017'].filter(id => byId(id)).map(id => <a href={byId(id)!.canonical_route}>{byId(id)!.name}</a>)}</nav>
    </div>
    <p class="image-disclaimer">Lifestyle images are AI-generated illustrations. They do not show actual MGI customers, employees or completed work.</p>
  </div>
</footer>
<script>
document.querySelectorAll('details.mobile-menu, details.header-help').forEach(menu => {
  menu.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      menu.removeAttribute('open');
      menu.querySelector('summary')?.focus();
    }
  });
});
</script>
<ServiceTitanScheduler/>
</body>
</html>
