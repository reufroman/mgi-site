---
import type {Route,Content} from '../data/types';
import {byId,photos} from '../data/catalog.mjs';
import Photo from './Photo.astro';
import CredentialLogos from './CredentialLogos.astro';
interface Props {route:Route;content:Content & {homeownerHub?:any};}
const {content,route}=Astro.props;
const hub=content.homeownerHub;
if(!hub)throw new Error("Homeowner hub content missing from approval payload");
const groups=hub.groups.filter((group:any)=>byId(group.pageId));
const topics=[...new Map(groups.map((g:any)=>[g.topicId,{id:g.topicId,label:g.topicLabel}])).values()] as {id:string;label:string}[];
const ready=byId(hub.ready.pageId);
const orientation=byId(hub.orientation.pageId);
const pictures=photos(route.page_id);
const photo=(id:string)=>pictures.find(p=>p?.placement_id===id);
---
<article class="homeowner-hub" data-homeowner-hub>
 <section class="hero hub-opening"><div class="wrap">
  <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">Homeowner answers</span></nav>
  <div class="hero-grid"><div><p class="hub-eyebrow">HVAC answers for homeowners</p><h1>{content.title}</h1><p class="lede">{content.summary}</p><a class="button" href="#situations">Find your starting point <span aria-hidden="true">↘</span></a></div><Photo image={photo('answers-opening')} caption="One more hand together." eager tilt={-2}/></div>
  <CredentialLogos/>
 </div></section>
 <section class="section hub-discovery" id="situations" aria-labelledby="hub-situations-heading"><div class="wrap">
 <div class="hub-heading"><h2 id="hub-situations-heading">Find an answer for your home.</h2><p>{content.answer}</p></div>
 {groups.length>0&&<div class="hub-filter" data-hub-filter hidden><label for="hub-query">{hub.filter.label}</label><div class="hub-query-row"><input id="hub-query" type="search" placeholder={hub.filter.placeholder} autocomplete="off" aria-describedby="hub-result-count"/><button type="button" data-hub-clear>Clear filters</button></div>
 <div class="hub-topics" role="group" aria-label="Filter by equipment"><button type="button" data-topic="all" aria-pressed="true">All answers <span>{groups.length}</span></button>{topics.map(topic=><button type="button" data-topic={topic.id} aria-pressed="false">{topic.label} <span>{groups.filter((g:any)=>g.topicId===topic.id).length}</span></button>)}</div></div>}
 <p id="hub-result-count" class="hub-result-count" role="status" aria-live="polite">{groups.length} answers</p>
 <div data-hub-list class="hub-answer-list">{groups.map((group:any)=><article class="hub-answer" data-hub-card data-hub-group data-source-id={group.sourceId} data-topic-id={group.topicId} data-search-text={group.searchText}>
 <p class="hub-answer-topic">{group.topicLabel} <span aria-hidden="true"> / </span> {group.category}</p><h3><a href={group.destination}>{group.title}<span aria-hidden="true"> ↗</span></a></h3></article>)}</div>
 <div class="hub-more" data-hub-more-wrap hidden><button type="button" data-hub-more>Show more answers <span aria-hidden="true">↓</span></button></div>
 <div class="hub-no-match" data-hub-no-match hidden><h3>No matching answer</h3><p>{hub.filter.noMatch}</p><div class="hub-recovery"><button type="button" data-hub-clear>Clear filters</button><a href="#situations" data-hub-browse>Browse all answers</a>{ready&&<a href={ready.canonical_route}>Explore home service options</a>}</div></div>
 {groups.length===0&&<div class="hub-no-guides"><h3>Have a home-service question?</h3><p>Explore the service information to find your next starting point.</p>{ready&&<a href={ready.canonical_route}>Explore home service options</a>}</div>}
 </div></section>
 <section class="section hub-starts"><div class="wrap"><div class="hub-heading"><h2>A little clarity goes a long way.</h2><p>Find the information that helps with the decision in front of you.</p></div><div class="hub-groups">
 <div class="hub-group"><Photo image={photo('answers-decisions')} caption="Make time for a little fun." tilt={2}/><div><h3>Something has changed.</h3><p>Search what you notice: a sound, a leak, or a room that feels different. Read what the symptom can mean and what needs a closer look.</p><a class="hub-start-link" href="#situations" data-hub-start="repair">Explore repair questions <span aria-hidden="true">↑</span></a></div></div>
 <div class="hub-group"><Photo image={photo('answers-care')} caption="Stay for another cup." tilt={-2}/><div><h3>You want to care for your home.</h3><p>Understand filters, routine care, and equipment settings. Keep the useful details together for the next conversation.</p><a class="hub-start-link" href="#situations" data-hub-start="maintenance">Explore care questions <span aria-hidden="true">↑</span></a></div></div>
 </div></div></section>
 {orientation&&<section class="section dark"><div class="wrap"><div class="hub-heading"><h2>New home. A few useful first steps.</h2><p>You do not need to learn your whole system at once. Start with a simple home record.</p></div><div class="hub-story"><Photo image={photo('answers-orientation')} caption="Room for the next big idea." tilt={2}/><div><ul class="hub-steps"><li><span aria-hidden="true">01</span><div><h3>Know what you have.</h3><p>Gather equipment names, manuals, and any records the seller left.</p></div></li><li><span aria-hidden="true">02</span><div><h3>Keep your questions together.</h3><p>Note what is missing and what you notice in each room.</p></div></li><li><span aria-hidden="true">03</span><div><h3>Choose one next step.</h3><p>Use the checklist to sort a current problem from routine care.</p></div></li></ul><a class="button light" href={orientation.canonical_route+'#home-checklist'}>Use the new-homeowner checklist <span aria-hidden="true">↗</span></a></div></div></div></section>}
 {ready&&<section class="section hub-close"><div class="wrap"><div class="hub-heading"><h2>Turn your question into a next step.</h2><p>A guide can help you prepare. When the question needs a look at your equipment, start with the service that fits.</p></div><div class="hub-story"><div><h3>Tell us what you notice.</h3><p>Warm air, a new sound, or a system that will not start. You do not need to name the failed part before exploring help.</p><a class="button" href={ready.canonical_route} data-hub-ready>{hub.ready.label}<span aria-hidden="true"> ↗</span></a><p class="hub-small">Read about the service and what to share before requesting a visit.</p></div><Photo image={photo('answers-close')} caption="Make something together." tilt={-2}/></div><p class="hub-disclosure">Lifestyle scenes are AI-generated illustrations, not photographs of MGI customers or completed work.</p></div></section>}
</article>
<script>
function initializeHub(){
 const root=document.querySelector<HTMLElement>('[data-homeowner-hub]');if(!root||root.dataset.initialized)return;
 const input=root.querySelector<HTMLInputElement>('#hub-query');if(!input)return;root.dataset.initialized='true';
 const groups=Array.from(root.querySelectorAll<HTMLElement>('[data-hub-group]'));
 const count=root.querySelector<HTMLElement>('#hub-result-count')!;const empty=root.querySelector<HTMLElement>('[data-hub-no-match]')!;
 const moreWrap=root.querySelector<HTMLElement>('[data-hub-more-wrap]')!;const more=root.querySelector<HTMLButtonElement>('[data-hub-more]')!;
 const buttons=Array.from(root.querySelectorAll<HTMLButtonElement>('[data-topic]'));
 let topic='all',limit=12;
 const normalize=(value:string)=>value.normalize('NFKC').toLowerCase().replace(/[^a-z0-9]+/g,' ').trim();
 const apply=(updateURL=false)=>{
  const words=normalize(input.value).split(' ');const matches=groups.filter(g=>(topic==='all'||g.dataset.topicId===topic)&&words.every(word=>normalize(g.dataset.searchText||'').includes(word)));
  groups.forEach(g=>g.hidden=true);matches.slice(0,limit).forEach(g=>g.hidden=false);
  count.textContent=matches.length?`Showing ${Math.min(limit,matches.length)} of ${matches.length} ${matches.length===1?'answer':'answers'}`:'No answers matched';
  empty.hidden=matches.length>0;moreWrap.hidden=matches.length<=limit;buttons.forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.topic===topic)));
  if(updateURL){const url=new URL(location.href);for(const key of ['q','topic','shown'])url.searchParams.delete(key);if(input.value.trim())url.searchParams.set('q',input.value.trim());if(topic!=='all')url.searchParams.set('topic',topic);if(limit>12)url.searchParams.set('shown',String(limit));history.replaceState(history.state,'',url);}
 };
 const restore=()=>{const url=new URL(location.href);input.value=url.searchParams.get('q')||'';const requested=url.searchParams.get('topic');topic=buttons.some(b=>b.dataset.topic===requested)?requested!:'all';limit=Math.max(12,Math.min(groups.length,Number(url.searchParams.get('shown'))||12));apply();};
 const clear=()=>{input.value='';topic='all';limit=12;apply(true);};
 root.querySelector<HTMLElement>('[data-hub-filter]')!.hidden=false;
 input.addEventListener('input',()=>{limit=12;apply(true);});buttons.forEach(b=>b.addEventListener('click',()=>{topic=b.dataset.topic!;limit=12;apply(true);}));
 root.querySelectorAll<HTMLButtonElement>('[data-hub-clear]').forEach(b=>b.addEventListener('click',()=>{clear();input.focus();}));
 root.querySelector('[data-hub-browse]')?.addEventListener('click',()=>{clear();input.focus();});
 root.querySelectorAll<HTMLElement>('[data-hub-start]').forEach(link=>link.addEventListener('click',()=>{clear();input.value=link.dataset.hubStart!;apply(true);input.focus({preventScroll:true});}));
 more.addEventListener('click',()=>{const previous=groups.filter(g=>!g.hidden).length;limit+=12;apply(true);const next=groups.filter(g=>!g.hidden)[previous];next?.querySelector('a')?.focus({preventScroll:true});});
 window.addEventListener('pageshow',restore);window.addEventListener('popstate',restore);restore();
}
initializeHub();
</script>
<style>
.homeowner-hub [hidden]{display:none!important}.hub-eyebrow{font:700 13px/1.5 Manrope,Arial,sans-serif;letter-spacing:.07em;text-transform:uppercase;color:var(--teal);margin:0 0 16px}.hub-opening .hero-grid{align-items:center}.hub-safety{border-left:4px solid var(--teal);background:#f1f3ec;padding:22px 28px;margin:32px 0 0}.hub-safety h2{font-family:Manrope,Arial,sans-serif;font-size:18px;line-height:1.5;margin:0 0 12px}.hub-safety :global(p){font-size:14px;line-height:1.65;margin-bottom:12px}.hub-safety :global(p:last-child){margin-bottom:0}.hub-heading{text-align:center;margin:0 0 36px}.hub-heading h2,.hub-heading p{max-width:none;width:100%}.hub-heading p{margin-bottom:0}.hub-discovery{background:#f1f3ec;scroll-margin-top:24px}.hub-situation-links{display:flex;justify-content:center;flex-wrap:wrap;gap:12px;margin-bottom:24px}.hub-situation-links a{border:1px solid var(--teal);border-radius:8px;padding:12px 20px;font-size:15px;font-weight:700;min-height:44px;text-decoration:none}.hub-filter{max-width:none;margin:0 auto 32px}.hub-query-row{max-width:800px}.hub-topics{display:flex;flex-wrap:wrap;gap:10px;margin-top:24px}.hub-topics button{border-color:#bbc4bd;text-align:left;background:transparent}.hub-topics button span{font-size:12px;margin-left:5px;opacity:.8}.hub-topics button[aria-pressed="true"]{background:var(--teal);color:white;border-color:var(--teal)}.hub-result-count{font-size:14px;margin:0 0 18px}.hub-answer-list{display:grid;grid-template-columns:1fr 1fr;gap:16px}.hub-answer{padding:24px;background:var(--warm);border:1px solid #d6dbd1;border-radius:12px}.hub-answer h3{font:600 19px/1.5 Manrope,Arial,sans-serif;margin:0}.hub-answer h3 a{text-decoration:none}.hub-answer h3 a:hover{text-decoration:underline}.hub-answer-topic{font-size:12px;line-height:1.5;color:#486264;margin:0 0 10px}.hub-more{text-align:center;margin-top:28px}.hub-more button{padding:14px 28px}.hub-starts .hub-group{background:#f1f3ec}.hub-starts h3{font-size:30px}.hub-start-link{display:inline-block;min-height:44px;font-weight:700;padding:8px 0}.hub-no-match h3{font-size:30px}.hub-filter label{font-weight:600;font-size:15px;display:block;margin-bottom:8px}.hub-query-row{display:flex;gap:12px}.hub-query-row input{flex:1;min-width:0;border:1px solid #837c70;background:var(--warm);border-radius:8px;padding:14px;font:inherit;font-size:16px}.homeowner-hub button{min-height:44px;border:1px solid #837c70;border-radius:8px;background:var(--warm);color:var(--teal);padding:10px 16px;font:600 14px/1.5 Manrope,Arial,sans-serif;cursor:pointer}.hub-filter [role=status]{font-size:14px;margin:10px 0 0}.hub-groups{display:grid;grid-template-columns:1fr 1fr;gap:32px}.hub-group{min-width:0;background:var(--warm);padding:28px;border-radius:18px;scroll-margin-top:28px;display:flex;flex-direction:column}.hub-group :global(.polaroid){margin:0 0 28px;width:100%;max-width:none}.hub-group :global(.polaroid img){aspect-ratio:3/2;object-fit:cover}.hub-group-detail{flex:1;display:flex;flex-direction:column}.hub-guide h3{font-size:30px;line-height:1.2;margin:0 0 20px}.hub-guide h3 a{text-decoration-thickness:1px;text-underline-offset:5px}.hub-guide p{font-size:16px}.hub-service{border-top:1px solid #bcb5aa;margin-top:auto;padding-top:18px}.hub-service span:not([aria-hidden]){display:block;font-size:13px;margin-bottom:6px}.hub-service a,.hub-recovery a{display:inline-flex;align-items:center;min-height:44px;font-size:15px;font-weight:600}.hub-no-match{padding:32px;background:var(--warm);border-radius:18px}.hub-no-match h2{font-size:32px}.hub-recovery{display:flex;align-items:center;flex-wrap:wrap;gap:12px 24px}.hub-story{display:grid;grid-template-columns:1fr 1fr;gap:72px;align-items:center}.hub-story h3{font-size:30px}.hub-steps{list-style:none;padding:0;margin:0 0 28px}.hub-steps li{display:flex;gap:22px;padding:20px 0;border-bottom:1px solid #ffffff50}.hub-steps li:first-child{padding-top:0}.hub-steps li>span{font-size:36px;color:var(--lime,#b1c453);line-height:1.2}.hub-steps h3{margin:0 0 8px}.hub-steps p{font-size:16px;margin:0}.hub-close{background:#f1f3ec}.hub-small,.hub-disclosure{font-size:13px;line-height:1.6}.hub-small{margin-top:20px}.hub-disclosure{margin:48px 0 0}.homeowner-hub :is(a,button,input):focus-visible{outline:3px solid var(--teal);outline-offset:4px}.homeowner-hub .dark a:focus-visible{outline-color:white}
@media(max-width:767px){.hub-answer-list{grid-template-columns:1fr}.hub-answer{padding:20px}.hub-answer h3{font-size:18px}.hub-topics{gap:8px}.hub-topics button{font-size:13px;padding:10px 12px}.hub-groups,.hub-story{grid-template-columns:1fr;gap:36px}.hub-group{padding:22px}.hub-safety{padding:20px}.hub-query-row{flex-wrap:wrap}.hub-query-row input{flex-basis:100%}.hub-group :global(.polaroid){margin-bottom:24px}.hub-guide h3,.hub-story h3{font-size:27px}.hub-heading{margin-bottom:28px}.hub-no-match{padding:24px}.hub-situation-links{align-items:stretch}.hub-situation-links a{flex:1;text-align:center}.hub-close .hub-story>div{order:2}.hub-close .hub-story :global(figure){order:1}}
</style>
