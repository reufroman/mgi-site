---
import type {Route,Content} from '../data/types';
import type ACReviews from '../data/ac-repair-reviews.json';
import Photo from './Photo.astro';
import PriceTransparencyList from './PriceTransparencyList.astro';
import ServiceIcon from './ServiceIcon.astro';
import PrimaryActions from './PrimaryActions.astro';
import CredentialLogos from './CredentialLogos.astro';
import {photos,requestHref} from '../data/catalog.mjs';
import {acRepairContent} from '../data/ac-repair-standard.mjs';
interface Props {route:Route;content:Content;}
const {route,content}=Astro.props;
const data=acRepairContent(route.page_id,content);
const copy=data.acStandard!;
const request=requestHref(route);
const pictures=photos(route.page_id);
const picture=pictures.find(p=>p?.placement_id==='service-support');
const moment=(name:string)=>pictures.find(p=>p?.placement_id===name);
const sentences=(text:string)=>text.split(/(?<=[.!?])\s+/);
const preparationTitles=copy.visualStandard.preparationTitles;
const technicalTitles=copy.visualStandard.technicalTitles;
const technicalIcons=['cool','air','pump','care'];
const preparationIcons=['M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18ZM12 7v5l3 2','M3 10 12 3l9 7v11H3ZM9 21v-8h6v8','M5 5h14v16H5ZM8 3v4M16 3v4M5 10h14M9 14h2M13 14h2M9 17h2'];
const reviews=data.relevantReviews! as typeof ACReviews;
const [symptom,findings,technical,change,visit]=content.sections;
---
<article class="ac-standard">
<section class="hero"><div class="wrap">
<nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/services/">Services</a><span aria-hidden="true">/</span>{copy.cityBreadcrumb&&<><a href={copy.cityBreadcrumb.href}>{copy.cityBreadcrumb.name}</a><span aria-hidden="true">/</span></>}<span aria-current="page">{route.name}</span></nav>
<div class="hero-grid"><div><h1>{copy.heroHeading||data.title}</h1><p class="lede">{copy.heroBody||data.summary}</p><PrimaryActions href={request} label={data.ctaLabel}/>{copy.quickLinks&&<nav class="ac-paths" aria-label="On this page" style="justify-content:flex-start;padding-top:16px;gap:8px 20px;font-size:14px">{copy.quickLinks.map((link:{href:string;label:string})=><a href={link.href}>{link.label}</a>)}</nav>}</div>{picture&&<Photo image={picture} eager tilt={-2}/>}</div>
<CredentialLogos reviewHref="#ac-customer-review"/>
</div></section>
<section class="section ac-recognition" id="answer"><div class="wrap"><div class="ac-introduction"><h2>{copy.recognitionHeading}</h2><p>{copy.recognitionBody}</p></div>{copy.localContext&&!('body' in copy.localContext)&&<div class="ac-local-context"><h3>{copy.localContext.heading}</h3>{copy.localContext.intro&&<p>{copy.localContext.intro}</p>}<>{'body' in copy.localContext?<p>{copy.localContext.body}</p>:<div class="ac-local-places">{copy.localContext.places.map((place:{name:string;body:string})=><div><h4>{place.name}</h4><p>{place.body}</p></div>)}</div>}</></div>}<div class="ac-story-grid"><div class="ac-moment"><Photo image={moment('recognition-moment')} tilt={2} caption={copy.visualStandard.photoCaptions[0]}/></div><div class="ac-preparation">{[symptom,change,visit].map((section,index)=><div><span class="ac-preparation-symbol" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d={preparationIcons[index]}/></svg></span><div><h3>{preparationTitles[index]}</h3><ul>{sentences(section.body).map(line=><li>{line}</li>)}</ul></div></div>)}</div></div></div></section>
<section class="section ac-review-section" id="ac-customer-review"><div class="wrap"><div class="ac-introduction"><h2>{copy.reviewHeading}</h2>{copy.reviewIntro&&<p>{copy.reviewIntro}</p>}</div><div class="review-grid ac-review-grid">{reviews.map(review=><figure class="review-card ac-review"><span class="stars" aria-label={`${review.rating} out of 5 stars`}>★★★★★</span><blockquote>{review.text}</blockquote><figcaption><div class="reviewer-identity"><img class="reviewer-avatar" src={review.reviewerImage} alt="" width="48" height="48" loading="lazy" referrerpolicy="no-referrer"/><strong>{review.name}</strong></div><span>Google review · {new Date(review.date+'T12:00:00').toLocaleDateString('en-US',{month:'short',year:'numeric'})}</span><a href={review.source} target="_blank" rel="noopener noreferrer">Read on Google ↗</a></figcaption></figure>)}</div></div></section>
<section class="section ac-tint"><div class="wrap"><div class="ac-introduction"><h2 id={copy.quickLinks?'ac-symptoms':undefined} tabindex={copy.quickLinks?-1:undefined} style={copy.quickLinks?'scroll-margin-top:120px':undefined}>{copy.technicalHeading}</h2><p>{technical.body}</p></div><ul class="ac-details">{technical.bullets?.map((item,index)=><li><span class="ac-detail-symbol" aria-hidden="true"><ServiceIcon name={technicalIcons[index]}/></span><div><h3>{technicalTitles[index]}</h3>{copy.technicalLead?.[index]&&<p>{copy.technicalLead[index]}</p>}<p>{item}</p></div></li>)}</ul></div></section>
<section class="section"><div class="wrap"><div class="ac-introduction"><h2>{copy.findingsHeadingLines ? copy.findingsHeadingLines.map((line:string,index:number)=><>{index>0&&<br/>}{index>0?' ':''}{line}</>) : copy.findingsHeading}</h2></div><div class="ac-story-grid ac-story-reverse"><div class="ac-moment"><Photo image={moment('choice-moment')} tilt={-2} caption={copy.visualStandard.photoCaptions[1]}/></div><div class="ac-findings"><ul class="ac-findings-list">{sentences(findings.body).map((line,index)=><li><span aria-hidden="true">{String(index+1).padStart(2,'0')}</span><p>{line}</p></li>)}</ul>{copy.findingsActions&&<><p>{copy.findingsActionIntro}</p><div class="ac-paths" style="margin-bottom:24px"><PrimaryActions href={request} label={data.ctaLabel}/></div></>}<nav class="ac-paths" aria-label="AC repair or replacement guidance"><a class="button outline" href="/blog/repair-or-replace-air-conditioner/">Compare repair and replacement <span aria-hidden="true">↗</span></a><a href="/services/ac-replacement/">Explore AC replacement <span aria-hidden="true">↗</span></a></nav></div></div><PriceTransparencyList data={copy.priceTransparency} anchorOffset={Boolean(copy.quickLinks)}/>{copy.localContext&&'body' in copy.localContext&&<aside class="ac-local-context" style="margin-top:36px"><h3>{copy.localContext.heading}</h3>{copy.localContext.intro&&<p>{copy.localContext.intro}</p>}<p>{copy.localContext.body}</p></aside>}</div></section>
<section class="section green"><div class="wrap"><div class="ac-introduction"><h2 id={copy.quickLinks?'ac-next-steps':undefined} tabindex={copy.quickLinks?-1:undefined} style={copy.quickLinks?'scroll-margin-top:120px':undefined}>{copy.processHeading}</h2><p>{copy.processBody}</p></div><div class="ac-story-grid ac-process-layout"><div><ol class="process">{copy.steps.map(([heading,body]:[string,string])=><li><h3>{heading}</h3><p>{body}</p></li>)}</ol><div class="ac-actions"><PrimaryActions href={request} label={data.ctaLabel}/></div></div><div class="ac-moment"><Photo image={moment('process-moment')} tilt={2} caption={copy.visualStandard.photoCaptions[2]}/></div></div></div></section>
<section class="section"><div class="wrap"><div class="ac-introduction"><h2>{copy.faqHeading||'Questions about AC repair.'}</h2></div><div class="faq">{content.faqs.map(f=><details><summary>{f.question}</summary><p>{f.answer}</p></details>)}</div></div></section>
<section class="closing"><div class="wrap"><div class="ac-introduction"><h2>{copy.close}</h2><p>{copy.closeBody}</p></div><div class="ac-story-grid ac-closing-layout"><div class="ac-moment"><Photo image={moment('closing-moment')} tilt={-2} caption={copy.visualStandard.photoCaptions[3]}/></div><div class="ac-actions"><PrimaryActions dark href={request} label={data.ctaLabel}/></div></div></div></section>
</article>
<style>
.ac-local-context{margin:0 0 48px}.ac-local-context>h3,.ac-local-context>p{text-align:center;max-width:none}.ac-local-places{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px;margin-top:28px}.ac-local-places>div{border-top:1px solid #70969b;padding-top:20px}.ac-local-places h4{color:var(--warm);font-family:Manrope,Arial,sans-serif;font-size:18px;margin-bottom:12px}.ac-local-places p{font-size:16px}.ac-review-section .ac-introduction>p{color:var(--warm)}
@media(max-width:767px){.ac-local-places{grid-template-columns:1fr;gap:16px}}

.ac-standard .hero{padding-bottom:40px}.ac-standard h1{max-width:none;font-size:clamp(44px,4.6vw,68px)}
.ac-introduction{width:100%;text-align:center;margin-bottom:48px}.ac-introduction h2{max-width:none;margin-bottom:20px}.ac-introduction p{max-width:none;margin-bottom:0}
.ac-tint{background:#f2f3ed}.ac-story-grid{display:grid;grid-template-columns:1fr 1.15fr;gap:72px;align-items:center}.ac-moment{min-width:0;padding:12px}.ac-moment :global(.polaroid){width:100%;margin:0}.ac-story-reverse .ac-moment{order:2}
.ac-recognition{background:var(--teal);color:var(--warm)}.ac-recognition h2,.ac-recognition h3{color:var(--warm)}
.ac-preparation{display:grid;gap:24px}.ac-preparation>div{display:grid;grid-template-columns:96px 1fr;gap:24px;border-top:1px solid #668e91;padding-top:24px}.ac-preparation>div:first-child{border-top:0;padding-top:0}.ac-preparation-symbol{width:96px;height:96px;background:var(--green);color:var(--teal);border-radius:50%;display:grid;place-items:center}.ac-preparation-symbol svg{width:64px;height:64px}.ac-preparation h3{font-size:30px;margin-bottom:12px}.ac-preparation ul{padding-left:20px;margin:0;font-size:16px}.ac-preparation li+li{margin-top:8px}
.ac-findings-list{list-style:none;margin:0 0 28px;padding:0}.ac-findings-list li{display:grid;grid-template-columns:40px 1fr;gap:20px;border-bottom:1px solid #c9c5b8;padding:20px 0}.ac-findings-list li:first-child{padding-top:0}.ac-findings-list span{font:600 36px/1 Cormorant,Georgia,serif;color:var(--teal)}.ac-findings-list p{margin:0}
.ac-paths,.ac-actions{display:flex;flex-wrap:wrap;justify-content:center;align-items:center;gap:20px}.ac-paths>a{min-height:44px;display:inline-flex;align-items:center}.ac-findings .ac-paths{justify-content:flex-start}
.ac-details{display:grid;grid-template-columns:1fr 1fr;gap:24px;list-style:none;padding:0;margin:0}.ac-details li{display:grid;grid-template-columns:64px 1fr;gap:24px;padding:32px;background:var(--warm);border-radius:14px}.ac-detail-symbol{width:64px;height:64px;display:grid;place-items:center;background:var(--green);border-radius:50%;color:var(--teal)}.ac-detail-symbol :global(.service-icon){width:30px;height:30px}.ac-details h3{font-size:30px;margin-bottom:14px}.ac-details p{font-size:16px;margin:0}
.ac-review-section{background:#103C46}.ac-review-section h2{color:var(--warm)}.ac-review{max-width:none;margin:0;padding:32px;min-width:0}.ac-review blockquote{font-size:18px;line-height:1.6}
.ac-process-layout{grid-template-columns:1.15fr 1fr}.ac-process-layout .process{grid-template-columns:1fr;gap:24px}.ac-process-layout .process li{display:grid;grid-template-columns:64px 1fr;gap:8px 24px}.ac-process-layout .process li::before{grid-row:1/3;border:0;padding:0;margin:0;font:600 48px/1 Cormorant,Georgia,serif}.ac-process-layout .process h3{margin:0;font-size:30px}.ac-process-layout .process p{margin:0}.ac-process-layout .ac-actions{justify-content:flex-start;margin-top:28px}
.ac-closing-layout{grid-template-columns:1fr 1fr;gap:72px}.ac-closing-layout .ac-moment{max-width:480px;justify-self:center}.ac-standard .closing .ac-introduction{margin-bottom:40px}
@media(max-width:1000px){.ac-story-grid{gap:40px;grid-template-columns:1fr 1fr}.ac-details li{padding:24px;gap:16px;grid-template-columns:48px 1fr}.ac-detail-symbol{width:48px;height:48px}}
@media(max-width:767px){.ac-standard h1{font-size:40px}.ac-story-grid{grid-template-columns:1fr;gap:32px}.ac-story-reverse .ac-moment{order:0}.ac-recognition .ac-moment{order:2}.ac-preparation h3,.ac-details h3,.ac-process-layout .process h3{font-size:26px}.ac-preparation>div{grid-template-columns:64px 1fr;gap:16px}.ac-preparation-symbol{width:64px;height:64px}.ac-preparation-symbol svg{width:44px;height:44px}.ac-details{grid-template-columns:1fr;gap:16px}.ac-review{padding:28px}.ac-review blockquote{font-size:20px}.ac-introduction{margin-bottom:32px}.ac-moment{padding:8px 12px}.ac-process-layout .ac-actions{justify-content:center}.ac-closing-layout .ac-moment{max-width:100%}}
</style>
