---
import type {Route,Content} from '../data/types';
import Photo from './Photo.astro';
import CredentialLogos from './CredentialLogos.astro';
import proof from '../data/home-proof.json';
import pilot from '../data/family-pilot-services.json';
import {photos,requestHref} from '../data/catalog.mjs';
interface Props {route:Route;content:Content;}
const {route}=Astro.props;
const data=pilot['ST-059'];
const [recognition,trust,process,money,options]=data.sections;
const review=proof.reviews.find(record=>record.name===trust.review)!;
const picture=photos(route.page_id)[0];
const request=requestHref(route);
const observationLabels=['When it changed','What you notice','What you know','Your home and access'];
const observationIcons=['<circle cx="12" cy="12" r="8"/><path d="M12 7v5l3 2"/>','<path d="M3 10 12 3l9 7v11H3Z M9 21v-8h6v8 M6 10h2 M16 10h2"/>','<rect x="5" y="4" width="14" height="17" rx="2"/><path d="M9 4V2h6v2 M9 10h6 M9 14h6 M9 18h4"/>','<path d="M4 21V3h12v18 M2 21h20 M8 7h4 M8 11h4 M11 21v-6h3"/><circle cx="18" cy="12" r="3"/><path d="M18 15v6"/>'];
---
<article class="family-pilot repair-reference" data-family-pilot={route.page_id}>
<section class="hero repair-hero"><div class="wrap">
<nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/services/">Services</a><span aria-hidden="true">/</span><span aria-current="page">{route.name}</span></nav>
<div class:list={['repair-opening',{'with-photo':!!picture}]}>
<div class="opening-copy"><h1>{data.title}</h1><p class="lede">{data.summary}</p>
<div class="actions" data-primary-actions><a class="button" href={request}>{data.label}<span aria-hidden="true"> ↗</span></a><a class="text-link" href="#answer">What to know first <span aria-hidden="true">↓</span></a></div>
</div>
{picture&&<div class="repair-picture pilot-photo"><Photo image={picture} eager tilt={2}/></div>}
</div>
<aside class="repair-safety" data-safety aria-label="Emergency safety"><p>{data.safety} <strong>Do not wait for an HVAC visit.</strong></p></aside>
</div></section>
<section id="answer" class="repair-section repair-recognition" data-journey-stage="recognition" aria-labelledby="recognition-heading"><div class="wrap">
<div class="section-introduction recognition-introduction"><div><h2 id="recognition-heading">{recognition.heading}</h2></div><p>{recognition.body}</p></div>
<ul class="recognition-grid">{recognition.bullets!.map((item,index)=><li><div class="observation-symbol" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" set:html={observationIcons[index]}/></div><div class="observation-copy"><span class="recognition-mark" aria-hidden="true">{String(index+1).padStart(2,'0')}</span><h3>{observationLabels[index]}</h3><p>{item}</p></div></li>)}</ul>
</div></section>
<section id="pilot-trust" class="repair-section repair-trust" data-journey-stage="trust" aria-labelledby="trust-heading"><div class="wrap trust-grid-reference">
<div><h2 id="trust-heading">{trust.heading}</h2><p>{trust.body}</p>
<div class="repair-credentials"><CredentialLogos compact/><a class="text-link" href="/about/">Learn about MGI <span aria-hidden="true">↗</span></a></div></div>
<div class="trust-decision"><figure class="pilot-review"><span class="quote-mark" aria-hidden="true">“</span><blockquote>{review.text}</blockquote><figcaption>{review.name} · <a href={review.source}>Read this customer review</a></figcaption></figure>
<aside class="decision-action" data-context-cta><a class="button" href={request}>{data.label}<span aria-hidden="true"> ↗</span></a></aside></div>
</div></section>
<section id="pilot-process" class="repair-section repair-process" data-journey-stage="process" aria-labelledby="process-heading"><div class="wrap">
<div class="center-introduction"><h2 id="process-heading">{process.heading}</h2><p>{process.body}</p></div>
<ol class="repair-steps" aria-label="Decisions before agreeing to work">{process.steps!.map(([label,body],index)=><li><span aria-hidden="true" data-reveal>{String(index+1).padStart(2,'0')}</span><h3>{label}</h3><p>{body}</p></li>)}</ol>
</div></section>
<section id="pilot-money" class="repair-section repair-money" data-journey-stage="money" aria-labelledby="money-heading"><div class="wrap money-grid-reference">
<div><h2 id="money-heading">{money.heading}</h2><p>{money.body}</p><aside class="decision-action" data-context-cta><a class="button" href={request}>{data.label}<span aria-hidden="true"> ↗</span></a></aside></div>
<dl class="cost-options">{money.rows!.map(([label,body])=><div><dt>{label}</dt><dd>{body}</dd></div>)}</dl>
</div></section>
<section id="pilot-options" class="repair-section repair-options" data-journey-stage="options" aria-labelledby="options-heading"><div class="wrap">
<div class="section-introduction"><div><h2 id="options-heading">{options.heading}</h2></div><p>{options.body}</p></div>
<dl class="comparison-grid">{options.rows!.map(([label,body])=><div><dt>{label}</dt><dd>{body}</dd></div>)}</dl>
<nav class="reading-paths" aria-label={`${options.heading} reading`}>{options.links!.map(([href,label])=><a class="text-link" href={href}>{label}<span aria-hidden="true"> ↗</span></a>)}</nav>
</div></section>
<section class="repair-section repair-faq"><div class="wrap faq-grid-reference"><div><h2>Questions about {route.name.toLowerCase()}</h2></div><div class="faq">{data.faqs.map(([question,answer])=><details><summary>{question}</summary><p>{answer}</p></details>)}</div></div></section>
<section class="closing repair-closing"><div class="wrap close-grid"><div><h2>{data.close}</h2><p>{data.closeBody}</p></div><div class="closing-action"><div class="actions"><a class="button light" href={request}>{data.label}<span aria-hidden="true"> ↗</span></a></div></div></div></section>
</article>
<style>
.repair-reference{--repair-tint:#eff2e3}.repair-hero{padding:48px 0 56px}.breadcrumb{margin-bottom:40px}.repair-opening{display:grid;align-items:center;gap:64px}.repair-opening.with-photo{grid-template-columns:1.1fr 1fr}.repair-reference h1{font-size:clamp(48px,4.45vw,64px);line-height:1.04;max-width:17ch;margin-bottom:24px}.repair-reference h2{font-size:clamp(36px,3.5vw,48px);line-height:1.08;margin-bottom:24px}.repair-reference h3{font-size:28px;line-height:1.12}.repair-reference p{max-width:68ch}.repair-reference .lede{font-size:19px;line-height:1.6;margin-bottom:28px}.repair-reference .button{white-space:normal;max-width:100%;text-align:left}.text-link{display:inline-flex;align-items:center;gap:12px;min-height:44px;font-size:15px;font-weight:600}.repair-picture{padding:16px 20px}.repair-safety{border-top:1px solid #c8c2b9;padding-top:20px;margin-top:40px}.repair-safety p{max-width:100ch;font-size:12px;line-height:1.65;margin:0}.repair-section{padding:80px 0}.section-introduction{display:grid;grid-template-columns:1fr 1.1fr;gap:80px;align-items:center;margin-bottom:32px}.section-introduction h2{margin-bottom:0}.section-introduction>p{margin-bottom:0}.repair-recognition{background:var(--repair-tint)}.recognition-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:32px;padding:0;list-style:none;margin:40px 0 0}.recognition-introduction{display:block;max-width:720px;margin:0 auto;text-align:center}.recognition-introduction h2{margin-bottom:20px}.recognition-introduction>p{margin:0 auto}.recognition-grid{gap:48px;margin-top:48px}.recognition-grid li{position:relative;text-align:left}.observation-symbol{display:grid;place-items:center;width:72px;height:72px;border-radius:50%;background:var(--teal);color:var(--warm);margin-bottom:24px}.observation-symbol svg{width:34px;height:34px}.recognition-grid li:not(:last-child)::after{content:"";position:absolute;top:31px;left:calc(50% + 12px);width:44px;height:10px;background:var(--teal);clip-path:polygon(0 40%,78% 40%,78% 0,100% 50%,78% 100%,78% 60%,0 60%)}.recognition-mark{font:700 12px/1.3 Manrope,sans-serif;letter-spacing:.1em;color:var(--teal);display:block;margin-bottom:12px}.recognition-grid h3{font-size:28px;margin-bottom:12px}.recognition-grid p{font-size:16px;margin:0}.trust-grid-reference{display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:start}.repair-credentials{border-top:1px solid #c8c2b9;margin-top:28px;padding-top:20px}.repair-proof-logos{display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:24px 16px;margin-bottom:20px}.repair-proof-logos a{display:flex;align-items:center;justify-content:center;width:112px;min-height:100px}.proof-logo-frame{height:100px;display:flex;align-items:center;justify-content:center}.proof-logo-frame img,.proof-logo-frame .bbb-proof-logo,.proof-logo-frame .google-proof-logo{width:112px;height:100px;object-fit:contain}.repair-credentials .small-copy{margin-top:12px}.pilot-review{position:relative;background:#f5f2ed;border:1px solid #d3ccc1;padding:32px;margin:0}.quote-mark{display:block;font:600 72px/.8 Cormorant,Georgia,serif;color:var(--teal);height:48px}.pilot-review blockquote{font:600 27px/1.25 Cormorant,Georgia,serif;color:var(--teal);margin:12px 0 24px}.pilot-review figcaption{font-size:14px;line-height:1.7}.pilot-review figcaption a{display:inline-flex;align-items:center;min-height:44px}.pilot-review .small-copy{margin-bottom:0}.decision-action{margin-top:28px}.decision-action .small-copy{margin:16px 0 0}.repair-process{background:var(--teal);color:var(--warm)}.repair-process h2,.repair-process h3{color:var(--warm)}.center-introduction{max-width:740px;margin:0 auto 48px;text-align:center}.center-introduction p{margin-left:auto;margin-right:auto}.repair-steps{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(3,1fr);gap:48px}.repair-steps li{border-top:1px solid #8dabb0;padding-top:24px}.repair-steps span{display:block;font:600 48px/1 Cormorant,Georgia,serif;margin-bottom:24px}.repair-steps h3{margin-bottom:16px}.repair-steps p{font-size:16px;margin-bottom:0}.money-grid-reference{display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:start}.cost-options{margin:0;display:grid;gap:20px}.cost-options>div{background:#f5f2ed;border:1px solid #d3ccc1;padding:32px}.cost-options dt,.comparison-grid dt{font:600 30px/1.1 Cormorant,Georgia,serif;color:var(--teal);margin-bottom:16px}.cost-options dd,.comparison-grid dd{margin:0;font-size:16px}.repair-options{background:var(--repair-tint)}.comparison-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:40px;margin:40px 0 24px}.comparison-grid>div{border-top:1px solid #abb298;padding-top:24px}.reading-paths{display:flex;gap:16px 32px;flex-wrap:wrap;border-top:1px solid #abb298;padding-top:20px}.faq-grid-reference{display:grid;grid-template-columns:1fr 1.3fr;gap:80px;align-items:start}.faq-grid-reference .faq{width:100%;margin:0}.repair-closing h2{max-width:16ch}.repair-closing .close-grid{grid-template-columns:1.2fr 1fr}.closing-action{justify-self:end;max-width:420px}.repair-process a:focus-visible,.repair-closing a:focus-visible{outline-color:var(--warm)}
@media(max-width:1100px){.repair-opening{gap:40px}.section-introduction,.trust-grid-reference,.money-grid-reference,.faq-grid-reference{gap:40px}.recognition-grid{grid-template-columns:repeat(2,1fr);gap:40px}.recognition-grid li::after{display:none}.repair-steps,.comparison-grid{gap:24px}}
@media(max-width:767px){.repair-proof-logos{gap:20px 16px}.repair-proof-logos a{width:96px;min-height:96px}.proof-logo-frame,.proof-logo-frame img,.proof-logo-frame .bbb-proof-logo,.proof-logo-frame .google-proof-logo{width:96px;height:96px}.repair-hero{padding:32px 0 40px}.breadcrumb{margin-bottom:28px}.repair-opening,.repair-opening.with-photo,.section-introduction,.trust-grid-reference,.money-grid-reference,.faq-grid-reference,.repair-closing .close-grid{grid-template-columns:1fr;gap:32px}.repair-reference h1{font-size:40px;line-height:1.08;max-width:none}.repair-reference h2{font-size:32px}.repair-reference h3{font-size:26px}.repair-reference .lede{font-size:18px}.repair-picture{padding:8px 12px}.repair-safety{margin-top:28px}.repair-safety p{font-size:12px}.repair-section{padding:48px 0}.section-introduction{margin-bottom:24px}.recognition-grid{grid-template-columns:1fr;gap:20px;margin-top:24px}.recognition-introduction{text-align:left}.recognition-grid li{display:grid;grid-template-columns:56px 1fr;gap:20px;padding-top:20px;border-top:1px solid #abb298}.observation-symbol{width:56px;height:56px;margin:0}.observation-symbol svg{width:28px;height:28px}.recognition-mark{margin:0 0 8px}.recognition-grid h3{font-size:26px}.recognition-grid li:first-child{border-top:0;padding-top:0}.repair-steps,.comparison-grid{grid-template-columns:1fr;gap:28px}.repair-steps li{padding-top:20px}.repair-steps span{font-size:36px;margin-bottom:16px}.center-introduction{text-align:left;margin-bottom:32px}.center-introduction p{margin-left:0}.cost-options>div,.pilot-review{padding:24px}.pilot-review blockquote{font-size:26px}.comparison-grid{margin-top:24px}.reading-paths{flex-direction:column;gap:8px}.closing-action{justify-self:start;max-width:none}}
</style>
<style is:global>
body[data-page-id="ST-059"] .site-header .masthead{min-height:108px;grid-template-columns:1fr 110px 1fr}
body[data-page-id="ST-059"] .site-header .brand{padding:8px;margin-bottom:0}
body[data-page-id="ST-059"] .site-header .brand img{width:96px}
@media(max-width:767px){body[data-page-id="ST-059"] .site-header .masthead{min-height:108px;grid-template-columns:104px minmax(0,1fr) 44px;grid-template-rows:54px 54px}body[data-page-id="ST-059"] .site-header .brand{width:104px}body[data-page-id="ST-059"] .site-header .brand img{width:88px}}
</style>
