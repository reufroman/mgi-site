---
import type {Route,Content} from '../data/types';
import {byId,categories} from '../data/catalog.mjs';
import {answerCategoryProfiles,categoryAnswers} from '../data/answer-categories.mjs';
interface Props {route:Route;content?:Content;}
const {route}=Astro.props;
const profile=answerCategoryProfiles[route.page_id as keyof typeof answerCategoryProfiles];
if(!profile)throw Error(`Missing answer category: ${route.page_id}`);
const answers=categoryAnswers(route.page_id).filter(answer=>byId(answer.pageId));
const groupNames=[...new Set(answers.map(answer=>answer.category))];
const groups=groupNames.map((name,i)=>({name,id:`questions-${i+1}`,answers:answers.filter(answer=>answer.category===name)}));
const service=byId(profile.serviceId);
const secondary='secondServiceId' in profile?byId(profile.secondServiceId):null;
const hub=byId('ST-012');
---
<article class="answer-category" data-answer-category>
 <header class="category-opening"><div class="wrap">
  <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span>{hub&&<><a href={hub.canonical_route}>Homeowner answers</a><span aria-hidden="true">/</span></>}<span aria-current="page">{route.name}</span></nav>
  <p class="category-eyebrow">Homeowner answer library</p><h1>{profile.title}</h1><p class="lede">{profile.description}</p>
  {hub&&<a class="category-back" href={hub.canonical_route}>Browse all equipment topics <span aria-hidden="true">↗</span></a>}
 </div></header>
 <section class="section category-discovery" aria-labelledby="category-find"><div class="wrap">
  <div class="category-heading"><h2 id="category-find">Start with your question.</h2><p>Choose the question closest to yours. Read the full answer for the details and next steps.</p></div>
  {answers.length>0&&<>
   <div class="category-search" data-category-search hidden><label for="category-query">Search these answers</label><div><input id="category-query" type="search" autocomplete="off" placeholder="Try a sound, symptom, or question" aria-describedby="category-count"/><button type="button" data-category-clear>Clear search</button></div></div>
   <p id="category-count" role="status" aria-live="polite">{answers.length} answers</p>
   <nav class="category-topics" aria-label="Jump to a question group">{groups.map(group=><a href={`#${group.id}`} data-category-jump>{group.name}</a>)}</nav>
   <div class="category-groups">{groups.map(group=><section class="category-group" id={group.id} data-category-group aria-labelledby={`${group.id}-heading`}><h2 id={`${group.id}-heading`}>{group.name}</h2><ul>{group.answers.map(answer=><li data-category-answer data-source-id={answer.sourceId} data-search={[answer.title,answer.topicLabel,answer.category].join(' ')}>{profile.topics.length>1&&<p class="category-equipment">{answer.topicLabel}</p>}<h3><a href={byId(answer.pageId)!.canonical_route}>{answer.title}<span aria-hidden="true"> ↗</span></a></h3></li>)}</ul></section>)}</div>
   <div class="category-empty" data-category-empty hidden><h2>No matching questions.</h2><p>Try a shorter phrase, clear the search, or browse the full answer library.</p><button type="button" data-category-clear>Clear search</button>{hub&&<a href={hub.canonical_route}>Browse all answers ↗</a>}</div>
  </>}
  {answers.length===0&&<div class="category-empty"><p>No answers are available in this topic yet.</p>{hub&&<a href={hub.canonical_route}>Browse the answer library ↗</a>}</div>}
 </div></section>
 {service&&<section class="section dark category-close"><div class="wrap"><h2>When your question needs a closer look.</h2><p>An answer can help you prepare. For a concern about your own equipment, explore the service and what to share before requesting a visit.</p><div class="category-actions"><a class="button light" href={service.canonical_route}>{profile.serviceLabel}<span aria-hidden="true"> ↗</span></a>{secondary&&<a class="category-secondary" href={secondary.canonical_route}>{'secondServiceLabel' in profile?profile.secondServiceLabel:secondary.name} ↗</a>}</div></div></section>}
 {categories.length>1&&<nav class="wrap category-other" aria-label="More equipment answer topics"><p>More homeowner answers</p><div>{categories.filter(item=>item.page_id!==route.page_id).map(item=><a href={item.canonical_route}>{item.name}</a>)}</div></nav>}
</article>
<style>
.category-opening{padding:64px 0 48px}.category-opening h1{max-width:950px}.category-opening .lede{max-width:800px}.category-eyebrow,.category-equipment{font:700 13px/1.5 Manrope,Arial,sans-serif;color:var(--teal)}.category-eyebrow{letter-spacing:.06em;text-transform:uppercase;margin-top:36px}.category-back{display:inline-block;min-height:44px;padding:12px 0}.category-discovery{background:#f1f3ec}.category-heading{text-align:center;margin-bottom:34px}.category-heading h2,.category-heading p{max-width:none}.category-search{max-width:820px;margin:auto}.category-search label{display:block;font-weight:700;margin-bottom:10px}.category-search>div{display:flex;gap:12px}.category-search input{min-width:0;flex:1;border:1px solid #829295;border-radius:6px;padding:15px;background:white;color:#18272a;font:inherit}.answer-category button{font:700 14px Manrope,Arial,sans-serif;min-height:48px;border:1px solid var(--teal);border-radius:6px;background:white;color:var(--teal);padding:12px 18px;cursor:pointer}#category-count{max-width:820px;margin:14px auto 24px;font-size:14px}.category-topics{display:flex;flex-wrap:wrap;gap:8px 20px;justify-content:center;margin-bottom:44px}.category-topics a{padding:8px 0;min-height:44px;font-size:14px}.category-groups{display:grid;grid-template-columns:1fr 1fr;gap:28px;align-items:start}.category-group{scroll-margin-top:32px;background:#fff;border-radius:14px;padding:30px}.category-group>h2{font-size:29px;line-height:1.2;margin:0 0 22px}.category-group ul{list-style:none;padding:0;margin:0}.category-group li{border-top:1px solid #d3dad3;padding:18px 0}.category-group li:last-child{padding-bottom:0}.category-group h3{font:600 17px/1.6 Manrope,Arial,sans-serif;margin:0}.category-group a{text-decoration:none;display:block}.category-group a:hover{text-decoration:underline}.category-equipment{margin:0 0 6px;font-size:12px}.category-empty{text-align:center;padding:24px}.category-empty a{display:inline-block;padding:14px}.category-close{text-align:center}.category-close h2{max-width:none}.category-close p{max-width:760px;margin:20px auto 28px}.category-actions{display:flex;justify-content:center;align-items:center;flex-wrap:wrap;gap:24px}.category-secondary{padding:12px 0}.category-other{padding-top:36px;padding-bottom:44px}.category-other p{font-weight:700}.category-other>div{display:flex;flex-wrap:wrap;gap:12px 24px}.category-other a{padding:10px 0;min-height:44px}.answer-category [hidden]{display:none!important}.answer-category :is(a,input,button):focus-visible{outline:3px solid var(--teal);outline-offset:4px}.answer-category .dark a:focus-visible{outline-color:white}@media(max-width:767px){.category-opening{padding:64px 0 32px}.category-groups{grid-template-columns:1fr}.category-group{padding:24px}.category-search>div{flex-direction:column}.category-search input{width:100%}.category-topics{justify-content:flex-start;gap:4px 18px}.category-actions{align-items:stretch;flex-direction:column}.category-close h2{font-size:34px}}
</style>
<script>
const root=document.querySelector<HTMLElement>('[data-answer-category]');
if(root){
 const input=root.querySelector<HTMLInputElement>('#category-query');
 if(input){
  const rows=Array.from(root.querySelectorAll<HTMLElement>('[data-category-answer]'));
  const groups=Array.from(root.querySelectorAll<HTMLElement>('[data-category-group]'));
  const normalize=(value:string)=>value.normalize('NFKC').toLowerCase().replace(/[^a-z0-9]+/g,' ').trim();
  const apply=(update=false)=>{const terms=normalize(input.value).split(' ');let shown=0;rows.forEach(row=>{row.hidden=!terms.every(term=>normalize(row.dataset.search||'').includes(term));if(!row.hidden)shown++;});groups.forEach(group=>{group.hidden=!group.querySelector('[data-category-answer]:not([hidden])');});root.querySelector<HTMLElement>('#category-count')!.textContent=`${shown} ${shown===1?'answer':'answers'}${input.value.trim()?' matched':''}`;root.querySelector<HTMLElement>('[data-category-empty]')!.hidden=shown>0;if(update){const url=new URL(location.href);input.value.trim()?url.searchParams.set('q',input.value.trim()):url.searchParams.delete('q');history.replaceState(history.state,'',url);}};
  const restore=()=>{input.value=new URL(location.href).searchParams.get('q')||'';apply();};
  root.querySelector<HTMLElement>('[data-category-search]')!.hidden=false;
  input.addEventListener('input',()=>apply(true));
  root.querySelectorAll('[data-category-clear]').forEach(button=>button.addEventListener('click',()=>{input.value='';apply(true);input.focus();}));
  root.querySelectorAll('[data-category-jump]').forEach(link=>link.addEventListener('click',()=>{input.value='';apply(true);}));
  addEventListener('popstate',restore);addEventListener('pageshow',restore);restore();
 }
}
</script>
