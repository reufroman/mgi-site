---
import type {Route,Content} from '../data/types';
import batch from '../data/audit-batch-one.json';
import {photos,requestHref,review,contextFor} from '../data/catalog.mjs';
import Photo from './Photo.astro';
import ServiceIcon from './ServiceIcon.astro';
import CredentialLogos from './CredentialLogos.astro';
import EmergencyActions from './EmergencyActions.astro';
interface Props {route:Route;content:Content;}
const {route,content}=Astro.props;
type EmergencyData=typeof batch['ST-079'] & {localContext?:{heading:string;intro:string;body:string;places?:string[]};faqHeading?:string};
const data:EmergencyData=(content as Content & {emergencyStandard?:typeof batch['ST-079'] & {localContext?:{heading:string;intro:string;body:string;places?:string[]};faqHeading?:string}}).emergencyStandard || batch['ST-079'];
const local=contextFor(route);
const [symptoms,visit,waiting,findings,process]=data.sections;
const pictures=photos(route.page_id);
const moment=(id:string)=>pictures.find(p=>p?.placement_id===id);
const request=requestHref(route);
const cards=[{title:'No heat',icon:'heat',body:symptoms.rows![0][1],href:'/services/furnace-repair/',label:'Furnace repair'},{title:'No cooling',icon:'cool',body:symptoms.rows![1][1],href:'/services/ac-repair/',label:'AC repair'}];
const questions=[['Your address','Can my address and the requested work be served?'],['The next visit','What visit is actually available, and how will it be confirmed?'],['The visit charge','What does diagnosis cover, and what will it cost?'],['After-hours terms','Is help available outside regular hours, and is there an extra fee?']];
const steps=data.processSteps;
const safetyDetails=data.safetyDetails;
---
<article class="emergency-standard">
<section class="hero"><div class="wrap">
<nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/services/">Services</a><span aria-hidden="true">/</span><>{local&&<><a href={local.area.canonical_route}>{local.area.name.replace('HVAC Services in ','')}</a><span aria-hidden="true">/</span></>}</><span aria-current="page">{route.name}</span></nav>
<h1>{data.title}</h1>

<p class="lede">{data.summary}</p><EmergencyActions href={request}/><p class="availability">An urgent request does not confirm dispatch or an arrival time.</p>
<CredentialLogos/>
<aside class="emergency-safety" data-safety aria-labelledby="immediate-danger"><h2 id="immediate-danger">Smell gas, suspect carbon monoxide, or face immediate danger?</h2><p>If you smell gas, leave the area. From a safe place, call 911 and your gas utility. Do not use switches or try to relight the furnace. If you suspect carbon monoxide, get outside to fresh air and call 911. For smoke or other immediate danger, leave the area and call 911 from a safe place.</p><strong>Do not wait for an HVAC visit.</strong><details class="backup-safety"><summary>More safety guidance</summary><p>{safetyDetails.body}</p><ul>{safetyDetails.bullets.map(line=><li>{line}</li>)}</ul><a href={safetyDetails.source}>{safetyDetails.sourceLabel} <span aria-hidden="true">↗</span></a></details></aside>
</div></section>
<section class="section dark" id="answer" tabindex="-1"><div class="wrap"><div class="emergency-intro"><h2>{symptoms.heading}</h2><p>{symptoms.body}</p></div><div class="emergency-story"><Photo image={moment('symptom-moment')} caption="Leave time for another piece." tilt={-2}/><div class="emergency-concerns">{cards.map(card=><div><span class="emergency-symbol"><ServiceIcon name={card.icon}/></span><h3>{card.title}</h3><p>{card.body}</p><a href={card.href}>{card.label} <span aria-hidden="true">↗</span></a></div>)}</div></div></div></section>
<section class="section" id="visit-terms" tabindex="-1"><div class="wrap"><div class="emergency-intro"><h2>{visit.heading}</h2><p>Before you rely on a visit, ask these four questions. Repair work may have its own price.</p></div><div class="emergency-story"><div><div class="emergency-questions">{questions.map(([label,question],index)=><div><span class="emergency-number" aria-hidden="true">{String(index+1).padStart(2,'0')}</span><div><h3>{label}</h3><p>{question}</p></div></div>)}</div><EmergencyActions href={request}/><p>If no visit is available, ask the office what help it can actually offer.</p></div><Photo image={moment('visit-moment')} caption="Make time for a little fun." tilt={2}/></div></div></section>
<section class="section emergency-waiting" id="safe-waiting"><div class="wrap"><div class="emergency-intro"><h2>{waiting.heading}</h2><p>{waiting.body}</p></div><div class="emergency-call-now"><a class="button" href="tel:+19702871673"><ServiceIcon name="phone"/>Call MGI now</a></div></div></section>
<section class="section" id="call-type"><div class="wrap"><div class="emergency-intro"><h2>{findings.heading}</h2><p>{findings.body}</p></div><div class="emergency-story"><Photo image={moment('findings-moment')} caption="Stay for another cup." tilt={-2}/><div><ol class="emergency-findings">{findings.bullets!.map(item=><li><strong>{item.slice(0,item.indexOf(':'))}</strong><p>{item.slice(item.indexOf(':')+2)}</p></li>)}</ol><EmergencyActions href={request}/></div></div></div></section>
<section class="section green"><div class="wrap"><div class="emergency-intro"><h2>{process.heading}</h2><p>{process.body}</p></div><div class="emergency-story"><div><ol class="process">{steps.map(([title,body],index)=><li><h3>{title}</h3><p>{body}</p>{review&&route.page_id==='ST-079'&&index===0&&<aside class="claim-review" data-client-review-note><strong>For MGI review:</strong> Confirm immediate-dispatch availability, hours, and service conditions before approving this promise.</aside>}</li>)}</ol><EmergencyActions href={request}/></div><Photo image={moment('process-moment')} caption="A little room to make something." tilt={2}/></div></div></section>
<section class="section"><div class="wrap"><div class="emergency-intro"><h2>{'faqHeading' in data ? data.faqHeading : 'Emergency HVAC service questions.'}</h2></div><div class="faq">{content.faqs.map(f=><details><summary>{f.question}</summary><p>{f.answer}</p></details>)}</div></div></section>
<section class="section dark"><div class="wrap"><div class="emergency-intro"><h2>{data.close}</h2><p>{data.closeBody}</p></div><div class="emergency-story"><Photo image={moment('closing-moment')} caption="One more hand together." tilt={-2}/><div><h3>Call MGI. Let’s get it fixed.</h3><p>No heat or no cooling? Make the call now. We’ll help you move from a stopped system to a plan for getting it working again.</p><EmergencyActions href={request} dark/></div></div><p class="emergency-origin">Lifestyle scenes are AI-generated illustrations, not photographs of MGI customers or completed work.</p></div></section>
</article>
<style>
.emergency-standard .hero{padding-bottom:48px}.emergency-standard h1{max-width:1000px}.emergency-standard .hero .lede{max-width:76ch}.emergency-safety{border-left:5px solid var(--teal);background:#f1f3ec;padding:24px;margin:28px 0;max-width:1000px}.emergency-safety h2{font:700 19px/1.5 Manrope,Arial,sans-serif;margin:0 0 12px}.emergency-safety p{font-size:16px;margin-bottom:12px}.emergency-safety strong{font-size:16px}.availability{font-size:14px;margin:0}.emergency-call-now{display:flex;justify-content:center}.backup-safety{margin-top:20px}.backup-safety summary{font-weight:700;cursor:pointer;padding:12px 0}.backup-safety p,.backup-safety li{font-size:15px}.backup-safety li{margin-bottom:12px}.emergency-intro{text-align:center;margin-bottom:44px}.emergency-intro h2{max-width:none;margin:0 0 20px}.emergency-intro p{max-width:none;margin:0;line-height:1.65}.emergency-story{display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center}.emergency-story>*{min-width:0}.emergency-concerns{display:grid;gap:28px}.emergency-concerns>div{position:relative;padding:0 0 24px 86px;border-bottom:1px solid #ffffff55}.emergency-concerns p{margin-bottom:12px}.emergency-symbol{position:absolute;left:0;top:0;display:grid;place-items:center;background:var(--green);color:var(--teal);border-radius:50%;width:64px;height:64px}.emergency-symbol :global(svg){width:36px;height:36px}.emergency-questions>div{display:flex;gap:20px;border-bottom:1px solid #c9c4b8;padding:20px 0}.emergency-questions h3{font-size:28px;margin-bottom:8px}.emergency-questions p{margin:0}.emergency-number{font:600 40px/1.2 Cormorant,Georgia,serif;color:var(--teal)}.emergency-waiting{background:#f2f3ed}.emergency-safe-copy{max-width:820px;margin:auto;border-left:4px solid var(--teal);padding-left:28px}.emergency-safe-copy li{margin-bottom:16px}.emergency-findings{padding-left:28px}.emergency-findings li{padding:20px 0 20px 12px;border-bottom:1px solid #c9c4b8}.emergency-findings li p{margin:8px 0 0}.emergency-findings li::marker{font:600 28px Cormorant,Georgia,serif;color:var(--teal)}.claim-review{font:400 14px/1.6 Manrope,Arial,sans-serif;border-left:3px solid var(--teal);padding:12px 16px;margin-top:16px;background:#ffffff80}.emergency-origin{font-size:13px;margin:44px 0 0}.emergency-standard .process{grid-template-columns:1fr;gap:24px}.emergency-standard .process h3{margin-bottom:8px}.emergency-standard .process p{margin-bottom:0}.emergency-standard :global(.button){max-width:100%;white-space:normal}.emergency-standard :global(.primary-actions){gap:12px}.emergency-standard :global(.primary-actions .button){font-size:14px}.emergency-standard :global(.credential-row){margin-top:36px}#answer,#visit-terms,#safe-waiting{scroll-margin-top:144px}.emergency-standard .dark a:focus-visible{outline-color:var(--warm)}
@media(max-width:900px){.emergency-story{gap:36px}.emergency-concerns>div{padding-left:76px}.emergency-symbol{width:56px;height:56px}}
@media(max-width:767px){.emergency-story{grid-template-columns:1fr;gap:36px}.emergency-intro{margin-bottom:32px}.emergency-safety{padding:20px}.emergency-safety h2{font-size:17px}.emergency-safety p{font-size:15px}.emergency-story :global(.polaroid){margin-inline:8px}.emergency-standard :global(.primary-actions){align-items:stretch}.emergency-safe-copy{padding-left:20px}.emergency-standard .hero{padding-bottom:40px}}
</style>
