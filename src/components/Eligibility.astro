<div class="form-panel"><h2>Build your rebate checklist.</h2><p>Choose your project stage to see what to gather. This tool does not calculate a rebate or confirm eligibility.</p><form id="eligibility"><div class="field"><label for="utility">Electric or gas provider (optional)</label><input id="utility" name="utility" placeholder="Check the name on your bill" maxlength="100"/></div><div class="field"><label for="project">Planned equipment</label><select id="project"><option>Heat pump</option><option>Heat-pump water heater</option><option>Other equipment</option><option>Not sure yet</option></select></div><div class="field"><label for="status">Has the work started?</label><select id="status"><option>Still planning</option><option>Already started or finished</option><option>Not sure</option></select></div><button class="button" type="submit">Show my checklist</button><section id="eligibility-result" role="status" class="status" tabindex="-1"></section><noscript><p>Gather your utility bill, equipment proposal, and project dates. Check requirements and application timing with the program administrator before counting a rebate.</p></noscript></form></div>
<script>
document.querySelector('#eligibility')?.addEventListener('submit',e=>{e.preventDefault();const result=document.querySelector<HTMLElement>('#eligibility-result')!;const stage=(document.querySelector('#status') as HTMLSelectElement).value;const project=(document.querySelector('#project') as HTMLSelectElement).value;const provider=(document.querySelector('#utility') as HTMLInputElement).value.trim();const items=[provider?`Check the current program for your ${provider} account.`:'Find your electric and gas provider names on your current bills.',project==='Not sure yet'?'Get a project recommendation before checking equipment requirements.':`Gather the exact model and installation proposal for ${project.toLowerCase()}.`,stage==='Already started or finished'?'Check application deadlines and whether approval was required before the work.':stage==='Still planning'?'Ask whether approval is needed before you purchase equipment or start work.':'Confirm the project dates and application timing.', 'Confirm installer requirements, current funding, and any home or income requirements with the program administrator.'];const heading=document.createElement('h3');heading.textContent='Your next checks';const list=document.createElement('ul');items.forEach(text=>{const li=document.createElement('li');li.textContent=text;list.append(li)});const note=document.createElement('p');note.textContent='Eligibility is not confirmed. Do not subtract a benefit from the project total until it is verified.';result.replaceChildren(heading,list,note);result.focus();});
</script>
