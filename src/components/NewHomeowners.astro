---
import type {Content,Route} from '../data/types';
import {photos,requestHref} from '../data/catalog.mjs';
import Photo from './Photo.astro';
import PrimaryActions from './PrimaryActions.astro';
import CredentialLogos from './CredentialLogos.astro';
interface Props {content:Content;route:Route;}
const {content,route}=Astro.props;
const request=requestHref(route);
const pictures=photos(route.page_id);
const photo=(id:string)=>pictures.find(p=>p?.placement_id===id);
const equipment=[['Heating','A furnace or heat pump helps warm the home. Find the name on an accessible label.'],['Cooling','Your home may have an AC or a heat pump. Note which rooms are served and what you notice.'],['Controls and hot water','Find the thermostat instructions and water-heater information. Keep these with your home records.']];
const records=[['Known','Installation dates, manuals, past repair invoices, and warranty papers you have.'],['Unknown','Missing dates or records. Leave them unknown until you have evidence.'],['What you notice','Which room is affected, when it happens, and any message already visible on the display.']];
const paths=[['A problem now','Start with what stopped working. Share the symptom and ask about a repair visit.','Explore repair services','/services/'],['A care question','Ask what a maintenance visit covers for the equipment in your home.','Explore maintenance','/services/hvac-maintenance/'],['A future decision','Understand the findings before comparing repair and replacement work.','Explore homeowner answers','/answers/']];
const checklist=[
 {title:'Find your starting point',items:['Find the thermostat instructions and note the current schedule.','Write down the heating, cooling, and water-heating equipment you can identify.','Photograph readable equipment labels without opening internal panels.']},
 {title:'Gather what you have',items:['Save manuals, installation papers, and warranty information in one folder.','Add any service records the seller provided; mark missing history as unknown.','Note the filter size and any replacement guidance in the equipment manual.']},
 {title:'Make a simple care plan',items:['Write down unusual sounds, room-temperature differences, or display messages.','List the questions you want to ask about operation, care, or a current problem.','Choose the next step: a repair question, routine care, or learning more.']}
];
---
<article class="newhome-standard">
<section class="hero"><div class="wrap"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">New Homeowner HVAC Guide</span></nav><div class="hero-grid"><div><p class="newhome-eyebrow">New Homeowner HVAC Guide</p><h1>{content.title}</h1><p class="lede">{content.summary}</p><PrimaryActions label="Start with your home" href="#know-your-equipment"/></div><Photo image={photo('newhome-opening')} caption="Settle into another chapter." eager tilt={-2}/></div><CredentialLogos/></div></section>
<section class="section dark" id="know-your-equipment" tabindex="-1" aria-labelledby="equipment-heading"><div class="wrap"><div class="newhome-intro"><h2 id="equipment-heading">Get to know the equipment in your home.</h2><p>{content.sections[0].body}</p></div><div class="newhome-story"><Photo image={photo('newhome-equipment')} caption="A little room to build a life." tilt={2}/><div class="newhome-equipment">{equipment.map(([heading,body],i)=><div><span aria-hidden="true"><svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">{i===0?<path d="M12 3c2 4-1 5 2 8 1-1 2-2 2-4 3 3 5 6 3 10-2 5-10 5-13 1C2 12 9 8 12 3Z"/>:i===1?<><path d="M12 2v20M3.3 7l17.4 10M3.3 17 20.7 7M9 4l3 3 3-3M9 20l3-3 3 3M4 10l4-1-1-4M17 19l-1-4 4-1M4 14l4 1-1 4M17 5l-1 4 4 1"/></>:<><rect x="5" y="3" width="14" height="18" rx="2"/><path d="M8 7h8M8 11h4M8 16h2M14 16h2"/></>}</svg></span><div><h3>{heading}</h3><p>{body}</p></div></div>)}</div></div><p class="newhome-small">You do not need a model number to ask a question. Start with what you know.</p></div></section>
<section class="section newhome-canvas"><div class="wrap"><div class="newhome-intro"><h2>Keep the useful facts in one place.</h2><p>{content.sections[1].body}</p></div><div class="newhome-story"><div class="newhome-records">{records.map(([heading,body],i)=><div><span aria-hidden="true">{String(i+1).padStart(2,'0')}</span><div><h3>{heading}</h3><p>{body}</p></div></div>)}<aside class="newhome-note"><h3>No records? You can still start.</h3><p>Tell MGI what you have and what is missing. Ask which details would help with your question.</p></aside></div><Photo image={photo('newhome-records')} caption="Stay for another cup." tilt={-2}/></div></div></section>
<section class="section" id="home-checklist" aria-labelledby="checklist-heading"><div class="wrap"><div class="newhome-intro"><h2 id="checklist-heading">Your first-days HVAC checklist.</h2><p>A few small steps can turn scattered information into a useful home record. Check off what you have done and bring the open questions to MGI.</p></div><div class="newhome-checklist">{checklist.map((group,g)=><fieldset><legend>{group.title}</legend>{group.items.map((item,i)=><label><input type="checkbox" name={`home-check-${g}-${i}`}/><span>{item}</span></label>)}</fieldset>)}</div><p class="newhome-checklist-status" role="status" aria-live="polite">0 of 9 steps checked</p><p class="newhome-checklist-help">Use this list at your own pace. Checks stay on this page while it is open; they are not sent to MGI. Keep a copy of your notes with your home records.</p>
<aside class="newhome-vip" aria-labelledby="vip-invitation"><div><p class="newhome-eyebrow">YOUR NEXT STEP: ONGOING CARE</p><h3 id="vip-invitation">You have a starting point. Now give care a place on the calendar.</h3><p>MGI’s VIP Comfort Club brings furnace and AC tune-ups into one membership, with member benefits and payment choices. See the detailed visit checklists, compare the plan, and decide whether it fits your home.</p></div><div><a class="button" href="/vip-membership/">Explore VIP Comfort Club <span aria-hidden="true">↗</span></a><a class="newhome-vip-detail" href="/vip-membership/#vip-tune-ups">See what the tune-ups include <span aria-hidden="true">↗</span></a><p>Know the equipment covered and the current terms before joining.</p></div></aside>
</div></section>
<section class="section"><div class="wrap"><div class="newhome-intro"><h2>Choose the first useful step.</h2><p>{content.sections[2].body}</p></div><div class="newhome-paths">{paths.map(([heading,body,label,href])=><div><h3>{heading}</h3><p>{body}</p><a href={href}>{label} <span aria-hidden="true">↗</span></a></div>)}</div><p class="newhome-small">A change of ownership does not mean your equipment needs replacing.</p><div class="newhome-urgent"><h3>Need urgent help?</h3><p>For a heating or cooling breakdown, use the urgent-service page to find the right next step. If there is immediate danger, do not wait for an HVAC visit.</p><a href="/services/emergency-hvac-service/">Emergency HVAC guidance <span aria-hidden="true">↗</span></a></div></div></section>
<section class="section green"><div class="wrap"><div class="newhome-intro"><h2>Make the next conversation useful.</h2><p>A short list of questions helps you understand the findings and choose what happens next.</p></div><div class="newhome-story"><Photo image={photo('newhome-conversation')} caption="Make room for a little imagination." tilt={2}/><ol class="newhome-steps"><li><span aria-hidden="true">01</span><div><h3>Explain what you notice.</h3><p>Share the equipment, the concern, and any records you have. Missing history can stay unknown.</p></div></li><li><span aria-hidden="true">02</span><div><h3>Get the scope clear.</h3><p>Ask what the visit covers, what it costs, and which appointment details the office needs to confirm.</p></div></li><li><span aria-hidden="true">03</span><div><h3>Understand the findings.</h3><p>Ask what was checked, what was found, and what could not be assessed.</p></div></li><li><span aria-hidden="true">04</span><div><h3>Choose your next step.</h3><p>Separate work needed now from future planning. Get the scope and price before approving extra work.</p></div></li></ol></div></div></section>
<section class="section newhome-canvas"><div class="wrap"><div class="newhome-intro"><h2>New homeowner HVAC questions.</h2></div><div class="faq">{content.faqs.map(f=><details><summary>{f.question}</summary><p>{f.answer}</p></details>)}</div></div></section>
<section class="section dark"><div class="wrap"><div class="newhome-intro"><h2>Make the house feel more like home.</h2><p>Start with a clear question about your heating and cooling, then get back to the moments you are making here.</p></div><div class="newhome-story"><Photo image={photo('newhome-close')} caption="One more hand together." tilt={-2}/><div><h3>Bring what you know. Ask about the rest.</h3><p>Tell MGI about the home and what you need help with. You do not have to identify the failed part or choose new equipment before the conversation.</p><PrimaryActions dark label="Ask about your home" href={request}/><p class="small-copy">The office will confirm service scope, visit details, and your appointment.</p></div></div></div></section>
</article>
<script>
const list=document.querySelector('.newhome-checklist');
const status=document.querySelector('.newhome-checklist-status');
if(list&&status){const update=()=>{const all=list.querySelectorAll<HTMLInputElement>('input[type="checkbox"]');status.textContent=`${Array.from(all).filter(input=>input.checked).length} of ${all.length} steps checked`;};list.addEventListener('change',update);update();}
</script>
<style>
.newhome-checklist{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}.newhome-checklist fieldset{min-width:0;margin:0;padding:24px;border:1px solid #b9c6c3;border-radius:16px}.newhome-checklist legend{padding:0 8px;font-size:21px;font-weight:700;color:#194f5c}.newhome-checklist label{display:flex;align-items:flex-start;gap:12px;padding:18px 0;cursor:pointer}.newhome-checklist label+label{border-top:1px solid #e1e5df}.newhome-checklist input{width:22px;height:22px;flex:0 0 22px;margin:3px 0 0;accent-color:#194f5c}.newhome-checklist input:focus-visible{outline:3px solid #194f5c;outline-offset:4px}.newhome-checklist input:checked+span{color:#194f5c}.newhome-checklist-status{font-weight:700;color:#194f5c;margin-top:24px}.newhome-checklist-help{font-size:14px;max-width:65ch}.newhome-vip{display:grid;grid-template-columns:1.5fr 1fr;gap:40px;align-items:center;background:#afc257;border-radius:20px;padding:36px;margin-top:40px}.newhome-vip h3{font-size:32px;margin:8px 0 20px}.newhome-vip p:last-child{margin-bottom:0}.newhome-vip-detail{display:block;margin:20px 0}.newhome-vip>div:last-child p{font-size:14px}.newhome-vip .newhome-eyebrow{font-size:13px;letter-spacing:.06em}@media(max-width:767px){.newhome-checklist,.newhome-vip{grid-template-columns:1fr}.newhome-vip{padding:24px;gap:28px}.newhome-vip h3{font-size:28px}}.newhome-intro{text-align:center;margin-bottom:48px}.newhome-intro h2,.newhome-intro p{max-width:none}.newhome-intro p{margin:0}.newhome-story{display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center}.newhome-eyebrow{font-weight:700;color:var(--teal)}.newhome-equipment>div,.newhome-records>div{display:flex;gap:24px;padding:22px 0;border-bottom:1px solid #bdc7c4}.newhome-equipment>div>span{display:grid;place-items:center;flex:0 0 64px;height:64px;border-radius:50%;background:#afc257;color:#194f5c;font-size:36px}.newhome-equipment h3,.newhome-records h3,.newhome-steps h3{margin:0 0 12px}.newhome-equipment p,.newhome-records p{margin:0}.newhome-records>div>span,.newhome-steps>li>span{color:#194f5c;font-family:Georgia,serif;font-size:36px}.newhome-canvas{background:#f1f3ec}.newhome-note{border-left:3px solid #afc257;padding-left:24px;margin-top:28px}.newhome-note h3{margin-bottom:12px}.newhome-paths{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}.newhome-paths>div{display:flex;flex-direction:column;padding:28px;border:1px solid #194f5c;border-radius:18px}.newhome-paths h3{margin-top:0}.newhome-paths a{margin-top:auto}.newhome-small{font-size:15px;text-align:center;margin-top:32px}.newhome-urgent{margin-top:32px;border-left:3px solid #afc257;padding-left:24px}.newhome-steps{list-style:none;padding:0;margin:0}.newhome-steps li{display:flex;gap:24px;padding:24px 0;border-top:1px solid #829540}.newhome-steps p{margin:0}@media(max-width:767px){.newhome-story,.newhome-paths{grid-template-columns:1fr}.newhome-story{gap:40px}.newhome-intro{margin-bottom:32px}.newhome-paths>div{padding:24px}.newhome-equipment>div{gap:16px}.newhome-equipment>div>span{flex-basis:52px;height:52px;font-size:30px}}
</style>
