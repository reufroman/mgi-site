---
import site from '../data/site.json';
import {services,areas,review} from '../data/catalog.mjs';
---
<div class="form-panel"><h2>What’s happening at home?</h2>{review&&<div class="notice"><strong>Example details only.</strong><p class="small-copy">Nothing is sent or saved. This review cannot arrange a visit.</p></div>}
{site.phone&&<p>Prefer to call? <a href={`tel:${String(site.phone).replace(/[^+0-9]/g,'')}`}>Call MGI at {String(site.phone)}</a>.</p>}
<form id="service-request" data-review={review?'true':'false'} novalidate>
 <div class="field-grid"><div class="field"><label for="request-name">Your name</label><input id="request-name" name="name" autocomplete="name" maxlength="100" required aria-describedby="name-error"/><p id="name-error" class="field-error"></p></div><div class="field"><label for="request-contact">Phone or email</label><input id="request-contact" name="contact" autocomplete="off" maxlength="160" required aria-describedby="contact-hint contact-error"/><p id="contact-error" class="field-error"></p><p class="field-hint" id="contact-hint">One way to reach you is enough.</p></div></div>
 <div class="field"><label for="request-address">Service address</label><input id="request-address" name="address" autocomplete="street-address" maxlength="240" required aria-describedby="address-error"/><p id="address-error" class="field-error"></p></div>
 <div class="field-grid"><div class="field"><label for="request-town">Town</label><select id="request-town" name="town"><option value="">Choose a town or ask about your address</option>{areas.map(a=><option>{a.name.replace('HVAC Services in ','')}</option>)}<option>Another town</option></select></div><div class="field"><label for="request-service">What kind of help?</label><select id="request-service" name="service"><option value="">Not sure yet</option>{services.map(s=><option>{s.name}</option>)}</select></div></div>
 <div class="field"><label for="request-concern">What have you noticed?</label><textarea id="request-concern" name="concern" maxlength="2000" required aria-describedby="concern-hint concern-error"></textarea><p id="concern-error" class="field-error"></p><p id="concern-hint" class="field-hint">Include when it started. Leave out payment details and sensitive information.</p></div>
 <p class="small-copy">A service request is not an appointment. Address coverage, visit terms and availability need to be checked.</p>
 <button class="button" type="submit">{review?"Review example request":"Send service request"}</button><div id="request-status" class="status" role="status" tabindex="-1" aria-live="polite"></div>
 <noscript><p>{review?"This example form needs JavaScript to show its review state. No request can be sent from this review site.":"This form needs JavaScript. Please use the contact method above to arrange the next step."}</p></noscript>
</form></div>
<script>
const form=document.querySelector<HTMLFormElement>('#service-request');
const requestKey=crypto.randomUUID();
const params=new URLSearchParams(location.search);
['service','town'].forEach(name=>{const select=form?.elements.namedItem(name) as HTMLSelectElement;const value=params.get(name);if(value&&[...select.options].some(o=>o.value===value))select.value=value;});
const topic=params.get('topic');const concern=form?.elements.namedItem('concern') as HTMLTextAreaElement|null;if(topic&&concern)concern.value='I would like help with '+topic.slice(0,160)+'.';
form?.addEventListener('submit',async event=>{event.preventDefault();const status=document.querySelector<HTMLElement>('#request-status')!;form.querySelectorAll('.field-error').forEach(el=>el.textContent='');form.querySelectorAll('[aria-invalid]').forEach(el=>el.removeAttribute('aria-invalid'));const invalid=[...form.querySelectorAll<HTMLInputElement|HTMLTextAreaElement>('[required]')].find(el=>!el.value.trim());const contact=(form.elements.namedItem('contact') as HTMLInputElement).value.trim();if(invalid){invalid.setAttribute('aria-invalid','true');status.textContent='Please fill in '+form.querySelector(`label[for="${invalid.id}"]`)?.textContent?.toLowerCase()+'.';const fieldError=document.querySelector('#'+invalid.name+'-error');if(fieldError)fieldError.textContent=status.textContent;invalid.focus();return;}
if(!(/^\S+@\S+\.\S+$/.test(contact)||/^\+?[\d\s().-]{7,24}$/.test(contact))){const field=form.elements.namedItem('contact') as HTMLInputElement;field.setAttribute('aria-invalid','true');status.textContent='Enter a phone number or email so the office could reach you.';document.querySelector('#contact-error')!.textContent=status.textContent;field.focus();return;}
if(form.dataset.review==='true'){status.textContent='Example request reviewed. Nothing was sent or saved. No appointment has been arranged.';status.focus();return;}
const submit=form.querySelector<HTMLButtonElement>('button[type=submit]')!;submit.disabled=true;status.textContent='Sending your request. Your visit is not yet arranged.';
try{const body=Object.fromEntries(new FormData(form).entries());const response=await fetch('/api/service-request',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({...body,idempotencyKey:requestKey})});const result=await response.json();if(response.status===422&&result.errors){let first:HTMLElement|null=null;for(const name of ['name','contact','address','concern']){if(typeof result.errors[name]!=='string')continue;const field=form.elements.namedItem(name) as HTMLInputElement|HTMLTextAreaElement;field.setAttribute('aria-invalid','true');const error=document.getElementById(name+'-error');if(error)error.textContent=result.errors[name];first??=field;}status.textContent=result.message||'Please check the marked fields.';if(first){submit.disabled=false;first.focus();return;}}status.textContent=response.ok&&result.state==='received'&&result.receiptId?result.message+' Reference: '+result.receiptId:result.message||'Your request could not be confirmed. No appointment has been arranged.';}catch{status.textContent='Your request could not be confirmed. No appointment has been arranged. Please use the verified contact path.';}finally{submit.disabled=false;if(!form.querySelector('[aria-invalid="true"]'))status.focus();}});
</script>

<style>
.form-panel{border:1px solid #b8c7bf;border-radius:16px;background:white;box-shadow:0 12px 35px #123e4810}.form-panel h2{font-size:32px;margin-top:0}.form-panel .field-error:empty{display:none}.form-panel .field-hint{font-size:13px}.form-panel input,.form-panel select,.form-panel textarea{min-height:48px}.form-panel textarea{min-height:140px}.form-panel .status:empty{display:none}
</style>
