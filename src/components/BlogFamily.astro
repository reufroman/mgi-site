---
import type {Route,Content} from '../data/types';
import {articles,articleIntent,byId,contentFor,photos} from '../data/catalog.mjs';
import Photo from './Photo.astro';
import {currentLiveBlogTitles,currentLiveBlogIds} from '../data/live-blog.mjs';
interface Props {route:Route;content:Content;}
const {route,content}=Astro.props;
const isIndex=route.page_id==='ST-013';
const intent=route.page_id==='BLOG-MANUAL-J'?{serviceId:'ST-060',safetyFirst:false}:articleIntent[route.page_id];
const liveArticles=currentLiveBlogIds.map(id=>articles.find(a=>a.page_id===id)).filter(Boolean);
const addedArticles=articles.filter(a=>!currentLiveBlogIds.includes(a.page_id));
const service=byId(intent?.serviceId);
const answers=byId('ST-012');
const blog=byId('ST-013');
const picture=photos(route.page_id)[0];
const wordCount=[content.answer,...content.sections.flatMap(s=>[s.heading,s.body,...(s.bullets||[])]),...content.faqs.flatMap(f=>[f.question,f.answer])].join(' ').split(/\s+/).length;
const related=articles.filter(a=>a.page_id!==route.page_id).sort((a,b)=>Number(articleIntent[b.page_id]?.serviceId===intent?.serviceId)-Number(articleIntent[a.page_id]?.serviceId===intent?.serviceId)).slice(0,3);
const sources=content.sources.filter(s=>s.startsWith('https://'));
const sourceLabel=(url:string)=>new URL(url).hostname.replace(/^www\./,'');
---
<article class="blog-family" data-blog-family={isIndex?'index':'article'}>
<div class="wrap">
<nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span>{!isIndex&&blog&&<><a href={blog.canonical_route}>Homeowner guides</a><span aria-hidden="true">/</span></>}<span aria-current="page">{isIndex?'Homeowner guides':route.name}</span></nav>
<header class="blog-header"><p class="eyebrow">{isIndex?'Learn about your home':'Homeowner guide'}</p><h1>{content.title}</h1>{isIndex?<p class="lede">Explore heating, cooling, and home comfort. Start with the question or decision in front of you.</p>:<p class="blog-meta">{Math.max(1,Math.ceil(wordCount/220))} min read</p>}</header>
{isIndex?<>
<section aria-labelledby="browse-guides"><h2 id="browse-guides">Find a useful starting point.</h2><div class="blog-search" hidden data-blog-search><label for="blog-query">Search homeowner guides</label><div><input id="blog-query" type="search" placeholder="Try furnace, heat pump, or repair"/><button type="button" class="button outline" data-blog-clear>Clear search</button></div><p role="status" aria-live="polite" data-blog-count>{articles.length} guides</p></div>
{[{title:'From the MGI blog',items:liveArticles},{title:'More homeowner guides',items:addedArticles}].filter(group=>group.items.length>0).map(group=><section class="blog-group" aria-label={group.title}><h3 class="blog-group-heading">{group.title}</h3><div class="blog-cards">{group.items.map(a=>a&&<a href={a.canonical_route} data-blog-card data-search={[currentLiveBlogTitles[a.page_id]||a.name,contentFor(a).summary].join(' ').toLowerCase()}><span>Homeowner guide</span><h4>{currentLiveBlogTitles[a.page_id]||contentFor(a).title}</h4><p>{contentFor(a).summary}</p><span>Read the guide ↗</span></a>)}</div></section>)}<p hidden data-blog-empty>No matching guide. Try a broader word or clear your search.</p></section>
{answers&&<aside class="blog-next"><h2>Have a specific question?</h2><p>Search the homeowner answer library by equipment or by what you notice.</p><a class="button" href={answers.canonical_route}>Explore homeowner answers <span aria-hidden="true">↗</span></a></aside>}
</>:<>
<div class:list={['blog-opening',{'blog-safety':intent?.safetyFirst}]} id="answer"><p>{content.answer}</p></div>
<div class="blog-reading-grid"><div class="blog-body">{content.sections.map((section,i)=><section class="blog-section"><h2 id={`blog-section-${i+1}`}>{section.heading}</h2><p>{section.body}</p>{section.bullets&&section.bullets.length>0&&<ul>{section.bullets.map(b=><li>{b}</li>)}</ul>}</section>)}
{content.faqs.length>0&&<section class="blog-section"><h2>Questions about this topic.</h2>{content.faqs.map(f=><details><summary>{f.question}</summary><p>{f.answer}</p></details>)}</section>}
{service&&<aside class="blog-next" data-context-cta><p class="eyebrow">Your next step</p><h2>{intent?.safetyFirst?'After any immediate danger is addressed, get help with the furnace.':'Put what you learned to work at home.'}</h2><p>{intent?.safetyFirst?'Follow the safety steps above first. Once the immediate concern is addressed, explore furnace repair and share what stopped working.':'Explore the service, then bring your equipment details, questions, and any findings you already have. The right next step depends on your home.'}</p><a class="button" href={service.canonical_route}>Explore {service.name.toLowerCase().replace(/^ac /,'AC ')} <span aria-hidden="true">↗</span></a></aside>}
{sources.length>0&&<section class="blog-sources"><h2>Source guidance</h2><ul>{sources.map(s=><li><a href={s} rel="noreferrer">{sourceLabel(s)}</a></li>)}</ul><p>General education does not diagnose your equipment or replace a qualified assessment.</p></section>}
{picture&&<div class="blog-photo"><Photo image={picture}/></div>}
</div><aside class="blog-contents"><details open><summary>In this guide</summary><nav aria-label="Article sections"><ol>{content.sections.map((s,i)=><li><a href={`#blog-section-${i+1}`}>{s.heading}</a></li>)}</ol></nav></details></aside></div>
{related.length>0&&<section class="blog-related"><h2>Keep exploring.</h2><div class="blog-cards">{related.map(a=><a href={a.canonical_route}><span>Homeowner guide</span><h3>{a.name}</h3><span>Read the guide ↗</span></a>)}</div></section>}
{blog&&<p class="blog-return"><a href={blog.canonical_route}>← All homeowner guides</a></p>}
</>}
</div></article>
<script>
const search=document.querySelector<HTMLElement>('[data-blog-search]');
const input=document.querySelector<HTMLInputElement>('#blog-query');
if(search&&input){search.hidden=false;const cards=[...document.querySelectorAll<HTMLElement>('[data-blog-card]')];const count=document.querySelector<HTMLElement>('[data-blog-count]')!;const empty=document.querySelector<HTMLElement>('[data-blog-empty]')!;const apply=()=>{const words=input.value.normalize('NFKC').trim().toLowerCase().split(/\s+/).filter(Boolean);let shown=0;cards.forEach(card=>{card.hidden=!words.every(word=>(card.dataset.search||'').normalize('NFKC').includes(word));if(!card.hidden)shown++;});count.textContent=`${shown} ${shown===1?'guide':'guides'}`;empty.hidden=shown>0;document.querySelectorAll<HTMLElement>('.blog-group').forEach(group=>{group.hidden=![...group.querySelectorAll<HTMLElement>('[data-blog-card]')].some(card=>!card.hidden);});};input.addEventListener('input',apply);document.querySelector('[data-blog-clear]')?.addEventListener('click',()=>{input.value='';apply();input.focus();});}
</script>
<style>
.blog-family{padding:36px 0 72px;background:var(--warm)}.blog-header{max-width:1000px;margin:32px 0 40px}.blog-header h1{font-size:clamp(38px,4.5vw,64px);line-height:1.12;max-width:none}.blog-meta{font-size:14px}.blog-opening{max-width:880px;margin-bottom:44px}.blog-opening p{font-size:20px;line-height:1.75}.blog-safety{max-width:none;border-left:5px solid var(--teal);padding:24px 32px;background:#f1f3ec}.blog-reading-grid{display:grid;grid-template-columns:minmax(0,2.3fr) minmax(240px,1fr);gap:64px;align-items:start}.blog-section{margin-bottom:40px}.blog-section h2{font-size:34px;line-height:1.2;scroll-margin-top:28px;max-width:none}.blog-section p,.blog-section li{font-size:17px;line-height:1.8}.blog-section li{margin-bottom:12px}.blog-section summary{font-weight:700;padding:18px 0;cursor:pointer}.blog-section details{border-top:1px solid #c8cfc3}.blog-contents{position:sticky;top:28px;background:#f1f3ec;padding:24px;border-top:3px solid var(--teal)}.blog-contents summary{font-weight:700;cursor:pointer}.blog-contents ol{list-style:none;padding:0}.blog-contents li{border-top:1px solid #c8cfc3}.blog-contents a{display:block;padding:12px 0;font-size:14px;line-height:1.5}.blog-next{margin:40px 0;padding:32px;background:#edf1df;border-radius:14px;border-top:4px solid #afc34f}.blog-next h2{font-size:34px;line-height:1.2;margin-top:0}.blog-next p{font-size:17px;line-height:1.7}.blog-next .button{font-size:15px}.blog-sources{border-top:1px solid #c8cfc3;padding-top:28px;margin-top:36px}.blog-sources h2{font-size:28px}.blog-sources a{display:inline-flex;align-items:center;min-height:24px}.blog-sources li,.blog-sources p{font-size:14px;line-height:1.7}.blog-photo{max-width:480px;margin:44px auto}.blog-cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}.blog-cards>a{display:flex;flex-direction:column;padding:28px;border:1px solid #c8cfc3;border-radius:14px;text-decoration:none;background:#fff;gap:14px}.blog-cards h3,.blog-cards h4{font-size:28px;line-height:1.25;margin:0}.blog-cards p{font-size:16px;line-height:1.7;margin:0}.blog-cards span{font-size:13px;font-weight:700}.blog-cards span:last-child{margin-top:auto;padding-top:14px}.blog-related{border-top:1px solid #c8cfc3;padding-top:36px;margin-top:60px}.blog-related .blog-cards{grid-template-columns:repeat(3,minmax(0,1fr))}.blog-related h3{font-size:25px}.blog-group{margin-bottom:40px}.blog-group-heading{font-size:28px;margin:28px 0 20px}.blog-return a{display:inline-block;padding:18px 0}.blog-search{max-width:740px;margin:28px 0}.blog-search label{display:block;font-weight:700;margin-bottom:10px}.blog-search>div{display:flex;gap:12px}.blog-search input{min-width:0;flex:1;min-height:48px;padding:12px;border:1px solid #829295;border-radius:6px;font:inherit}.blog-search p{font-size:14px}.blog-family [hidden]{display:none!important}.blog-family a:focus-visible,.blog-family summary:focus-visible{outline:3px solid var(--teal);outline-offset:4px}@media(max-width:900px){.blog-reading-grid{grid-template-columns:1fr;gap:32px}.blog-contents{position:static;grid-row:1}.blog-related .blog-cards{grid-template-columns:1fr}}@media(max-width:767px){.blog-family{padding-top:64px}.blog-cards{grid-template-columns:1fr}.blog-header{margin:24px 0 30px}.blog-opening p{font-size:18px}.blog-safety{padding:22px}.blog-next{padding:24px}.blog-section h2,.blog-next h2{font-size:30px}.blog-search>div{flex-wrap:wrap}.blog-search input{flex-basis:100%}}
</style>
