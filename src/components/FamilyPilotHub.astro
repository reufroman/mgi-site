---
import type {Route} from '../data/types';
import {hubPilot as data} from '../data/family-pilot-hub.mjs';
import {byId,photos} from '../data/catalog.mjs';
import Photo from './Photo.astro';
interface Props {route:Route;}
const {route}=Astro.props;
const picture=photos(route.page_id)[0];
---
<div class="family-hub" data-family-pilot="hub">
<section class="hero"><div class="wrap"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">Services</span></nav>
<div class="hub-opening"><div><h1>{data.title}</h1><p class="lede">{data.summary}</p><a class="urgent-reading" href="/services/emergency-hvac-service/">An urgent problem? Read what to do first ↗</a></div><nav class="need-choices" aria-label="Choose what your home needs">{data.choices.map(choice=><a href={choice.href}><h2>{choice.heading}</h2><p>{choice.body}</p><span>{choice.label} ↗</span></a>)}</nav>{picture&&<div class="hub-photo"><Photo image={picture} eager tilt={-2}/></div>}</div>
</div></section>
<section class="hub-section" id="answer"><div class="wrap"><div class="work-options">{data.groups.map(group=><section id={group.id} aria-labelledby={group.id+'-heading'}><h2 id={group.id+'-heading'}>{group.heading}</h2><p>{group.body}</p><nav aria-label={group.heading+' information'}>{group.ids.map(id=>byId(id)).filter(Boolean).map(item=><a href={item!.canonical_route}>{item!.name}<span aria-hidden="true">↗</span></a>)}</nav></section>)}</div></div></section>
<section class="hub-section hub-tint"><div class="wrap hub-comparison"><div><h2>{data.comparison.heading}</h2><p>{data.comparison.body}</p></div><nav aria-label="Repair or replace reading">{data.comparison.guides.map(([id,label])=>byId(id)&&<a href={byId(id)!.canonical_route}>{label}<span aria-hidden="true">↗</span></a>)}</nav></div></section>
<section class="hub-section"><div class="wrap"><div class="equipment-heading"><h2>{data.equipment.heading}</h2><p>{data.equipment.body}</p></div><nav class="equipment-options" aria-label="Equipment information">{data.equipment.ids.map(id=>byId(id)).filter(Boolean).map(item=><a href={item!.canonical_route}>{item!.name}<span aria-hidden="true">↗</span></a>)}</nav></div></section>
<section class="closing"><div class="wrap close-grid"><div><h2>{data.help.heading}</h2><p>{data.help.body}</p></div><a class="button light" href={data.help.href}>{data.help.label} ↗</a></div></section>
</div>
<style>
.hub-opening{grid-template-areas:"copy photo" "choices choices";display:grid;grid-template-columns:1.2fr 0.8fr;gap:64px;align-items:center}.hub-opening h1{max-width:14ch}.urgent-reading{display:inline-flex;min-height:44px;align-items:center;font-size:15px;font-weight:600}.hub-photo{grid-area:photo}.hub-opening>div:first-child{grid-area:copy}.need-choices{grid-area:choices;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px;margin-top:56px}.need-choices>a{display:flex;flex-direction:column;padding:28px;background:var(--teal);color:var(--warm);text-decoration:none;border-radius:4px}.need-choices h2{color:var(--warm);font-size:29px;line-height:1.12;margin:0 0 20px}.need-choices p{font-size:15px}.need-choices span{margin-top:auto;font-weight:700;font-size:15px}.need-choices>a:focus-visible{outline:3px solid #bd642f;outline-offset:5px}.hub-section{padding:80px 0}.hub-tint{background:#f2f3ed}.work-options{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:48px}.work-options h2{font-size:35px}.work-options nav,.hub-comparison nav{display:grid}.work-options nav a,.hub-comparison nav a,.equipment-options a{display:flex;align-items:center;justify-content:space-between;gap:20px;min-height:56px;padding:14px 0;border-bottom:1px solid #bcb5aa;font-size:15px;font-weight:600;text-decoration:none}.work-options nav a:hover,.equipment-options a:hover,.hub-comparison nav a:hover{text-decoration:underline}.work-options section{scroll-margin-top:40px}.hub-comparison{display:grid;grid-template-columns:1.2fr 1fr;gap:80px;align-items:start}.equipment-heading{max-width:680px}.equipment-options{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 48px}.family-hub .closing .button{justify-self:start}.family-hub .hero{padding-bottom:40px}
@media(max-width:900px){.hub-opening{gap:36px}.work-options{gap:28px}.need-choices{gap:16px}.need-choices>a{padding:22px}.hub-comparison{gap:40px}}
@media(max-width:767px){.hub-opening,.need-choices,.work-options,.hub-comparison,.equipment-options{grid-template-columns:1fr}.hub-opening{grid-template-areas:"copy" "choices" "photo"}.hub-opening{gap:28px}.hub-opening :global(.photo){max-width:380px}.need-choices{margin-top:32px}.need-choices>a{padding:24px}.hub-section{padding:48px 0}.work-options{gap:40px}.work-options h2{font-size:34px}.need-choices h2{color:var(--warm);font-size:29px}.equipment-options{gap:0}.family-hub .hero{padding-bottom:24px}}
</style>
