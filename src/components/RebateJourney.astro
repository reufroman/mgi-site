---
import type {Content,Route} from '../data/types';
import {photos,requestHref,byId} from '../data/catalog.mjs';
import Photo from './Photo.astro';
import PrimaryActions from './PrimaryActions.astro';
import CredentialLogos from './CredentialLogos.astro';
interface Props {route:Route;content:Content;}
const {route,content}=Astro.props;
const request=requestHref(route);
const planner=byId('ST-009');
const moment=(id:string)=>photos(route.page_id).find(p=>p?.placement_id===id);
const programs=[
 {id:'xcel',name:'Xcel Energy',kind:'Utility program',body:'Start with your Xcel account and the current Colorado program for the equipment you are considering. Check the latest measure requirements and amounts before choosing.',href:'https://www.xcelenergy.com/programs_and_rebates'},
 {id:'efficiency',name:'Efficiency Works',kind:'Utility program',body:'For eligible electric accounts with Fort Collins, Loveland, Longmont, or Estes Park utilities. Check the listed-provider requirement and whether your project needs approval before work starts.',href:'https://efficiencyworks.org/for-your-home-rebates-and-incentives/'},
 {id:'atmos',name:'Atmos Energy',kind:'Utility program',body:'Colorado SmartChoice includes qualifying natural-gas furnace upgrades for Atmos customers. Check the efficiency requirements, cost limit, funding, and application deadline.',href:'https://atmosphere.atmosenergy.com/ways-save/colorado-residential-smartchoice-energy-efficiency-rebates/'},
 {id:'united',name:'United Power',kind:'Utility program',body:'Check the heat-pump program for your United Power electric account. The equipment type, size, efficiency, and installation requirements affect the available benefit.',href:'https://www.unitedpower.com/heat-pumps'},
 {id:'pvrea',name:'Poudre Valley REA',kind:'Utility program',body:'Members can check the heating and cooling program for new qualifying equipment. Review the model, equipment-cost limit, required documents, and application deadline.',href:'https://pvrea.coop/for-members/rebates/heating-cooling-rebates/'},
 {id:'state',name:'Colorado heat-pump incentive',kind:'State program',body:'Ask how the current contractor incentive works for your heat pump or heat-pump water heater. Confirm contractor registration and how any qualifying discount appears on the invoice.',href:'https://energyoffice.colorado.gov/heat-pump-tax-credit'},
 {id:'carrier',name:'Carrier Cool Cash',kind:'Manufacturer offer',body:'Buying a new Carrier system? Check the current promotion, qualifying equipment combination, participating dealer, purchase dates, and claim deadline before counting an incentive.',href:'https://www.carrier.com/us/en/residential/homeowner-resources/rebates/'}
];
const services=[['ST-066','Heat pumps'],['ST-072','Heat-pump water heaters'],['ST-060','Furnaces'],['ST-062','Air conditioning']].map(([id,label])=>({label,route:byId(id)}));
---
<article class="rebate-standard">
<section class="hero"><div class="wrap"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">Rebates</span></nav>
<div class="hero-grid"><div><h1>{content.title}</h1><p class="lede">{content.summary}</p><PrimaryActions label="Explore rebate programs" href="#rebate-programs"/><p class="small-copy">Eligibility, funding, and deadlines vary. A possible rebate is not a confirmed discount or payment.</p></div><Photo image={moment('rebate-opening')} caption="Keep the kitchen dance." eager tilt={-2}/></div><CredentialLogos/></div></section>
<section class="section dark"><div class="wrap"><div class="rebate-intro"><h2>A few details make the rebate check useful.</h2><p>You do not need to know every program. Start with your utility accounts and the work you are planning.</p></div><div class="rebate-story"><Photo image={moment('rebate-preparation')} caption="Make room for a little flour." tilt={2}/><div><ul class="rebate-checks"><li><h3>Your electric and gas providers</h3><p>Check both bills. A town name alone does not tell you which utility program applies.</p></li><li><h3>The exact equipment</h3><p>Share the system you want to replace. Eligibility may depend on the model, efficiency, existing equipment, and installer.</p></li><li><h3>Where you are in the project</h3><p>Still planning, already purchased, or installed? Some programs require a check or approval before work begins.</p></li></ul><a class="button light" href={request}>Ask about your project <span aria-hidden="true">↗</span></a>{planner&&<p class="small-copy" style="margin-top:20px"><a href={planner.canonical_route}>Use the rebate planning checklist</a></p>}</div></div></div></section>
<section class="section" id="rebate-programs" tabindex="-1" aria-labelledby="rebate-programs-heading"><div class="wrap"><div class="rebate-intro"><h2 id="rebate-programs-heading">Find the programs worth checking.</h2><p>Your utility account is the starting point. State and manufacturer incentives have their own rules.</p></div>
<div class="rebate-filter"><label for="rebate-utility">Who supplies your home’s energy?</label><select id="rebate-utility"><option value="all">Show all programs</option><option value="xcel">Xcel Energy</option><option value="efficiency">Fort Collins, Loveland, Longmont, or Estes Park electric utility</option><option value="atmos">Atmos Energy</option><option value="united">United Power</option><option value="pvrea">Poudre Valley REA</option><option value="other">Another provider or not sure</option></select><p id="rebate-filter-note" role="status">These are program leads, not confirmation that your project qualifies.</p></div>
<div class="rebate-program-grid">{programs.map(p=><section class="rebate-program" data-program={p.id} data-program-kind={p.kind==='Utility program'?'utility':'other'}><p class="rebate-kind">{p.kind}</p><h3>{p.name}</h3><p>{p.body}</p><a href={p.href} rel="noopener noreferrer">See current rules and amounts <span aria-hidden="true">↗</span></a></section>)}</div>
<div class="rebate-program-action"><PrimaryActions label="Ask about rebate options" href={request}/><p class="small-copy">Program links help you check the rules. They do not confirm funding, equipment eligibility, or installer participation for your project.</p></div>
</div></section>
<section class="section rebate-canvas"><div class="wrap"><div class="rebate-intro"><h2>See the full price and the possible savings.</h2><p>A good comparison keeps the project price, what is due, and any later benefit separate.</p></div><div class="rebate-story"><div><ol class="rebate-money"><li><h3>The full project</h3><p>Equipment, installation, included work, exclusions, and any separate costs. Start with this total.</p></li><li><h3>A confirmed discount</h3><p>If a benefit reduces the invoice, ask for the amount and conditions in writing. Check what you will still owe.</p></li><li><h3>A possible later payment</h3><p>A check, bill credit, or tax benefit may arrive after the work. Confirm who receives it and when, before relying on it.</p></li></ol><div class="rebate-budget-note"><h3>What if the rebate does not arrive?</h3><p>Keep the full project price in your budget until the benefit is confirmed. Ask what happens if funding runs out or an application is declined.</p></div><a href="/financing/">Compare financing separately <span aria-hidden="true">↗</span></a></div><Photo image={moment('rebate-budget')} caption="A little time for the whole picture." tilt={-2}/></div></div></section>
<section class="section green"><div class="wrap"><div class="rebate-intro"><h2>Make the steps clear before the work begins.</h2><p>Know what needs checking, who submits each application, and how to follow the result.</p></div><div class="rebate-story"><Photo image={moment('rebate-process')} caption="More time to make something together." tilt={2}/><ol class="rebate-process">{content.sections.map((s,i)=><li><span aria-hidden="true">{String(i+1).padStart(2,'0')}</span><div><h3>{s.heading}</h3><p>{s.body}</p></div></li>)}</ol></div><div class="rebate-program-action"><PrimaryActions label="Talk through your project" href={request}/></div></div></section>
<section class="section"><div class="wrap"><div class="rebate-intro"><h2>The right system comes first.</h2><p>Explore the work your home needs. Then check incentives for the equipment that fits.</p></div><nav class="rebate-services" aria-label="Replacement projects">{services.map(s=>s.route&&<a href={s.route.canonical_route}>{s.label}<span aria-hidden="true">↗</span></a>)}</nav></div></section>
<section class="section rebate-canvas"><div class="wrap"><div class="rebate-intro"><h2>HVAC rebate questions.</h2></div><div class="faq">{content.faqs.map(f=><details><summary>{f.question}</summary><p>{f.answer}</p></details>)}</div></div></section>
<section class="section dark"><div class="wrap"><div class="rebate-intro"><h2>Plan the upgrade. Keep life at home in view.</h2><p>Start with the system your home needs and a clear picture of the cost.</p></div><div class="rebate-story"><Photo image={moment('rebate-close')} caption="A little room to plan." tilt={-2}/><div><h3>Bring your project and rebate questions.</h3><p>Talk with MGI about equipment options, the full price, and which rebate checks belong in your plan. Confirm the requirements before choosing.</p><PrimaryActions dark label="Ask about rebates" href={request}/><p class="small-copy">The office will confirm your appointment and visit details. Program eligibility and approval are separate checks.</p></div></div></div></section>
</article>
<script>
const filter=document.querySelector<HTMLSelectElement>('#rebate-utility');
filter?.addEventListener('change',()=>{const selected=filter.value;document.querySelectorAll<HTMLElement>('[data-program]').forEach(card=>{card.hidden=selected!=='all'&&card.dataset.programKind==='utility'&&card.dataset.program!==selected;});const note=document.querySelector<HTMLElement>('#rebate-filter-note');if(note)note.textContent=selected==='other'?'Check both utility bills and ask your provider about current programs. State and manufacturer leads are shown below; this list is not a complete program catalog.':selected==='all'?'These are program leads, not confirmation that your project qualifies.':'Showing this utility plus state and manufacturer leads. Check both electric and gas providers separately; selecting an account does not confirm eligibility.';});
const incoming=new URLSearchParams(location.search).get('service');const allowed=JSON.parse(document.body.dataset.replacementServices||'[]');if(incoming&&allowed.includes(incoming)){document.querySelectorAll<HTMLAnchorElement>('.rebate-standard a[href^="/schedule-service/"]').forEach(link=>{const url=new URL(link.href);url.searchParams.set('service',incoming);link.href=url.pathname+url.search+url.hash;});}
</script>
<style>
.rebate-intro{text-align:center;margin-bottom:48px}.rebate-intro h2,.rebate-intro p{max-width:none}.rebate-intro p{margin:0}.rebate-story{display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:72px}.rebate-canvas{background:#f2f3ed}.rebate-checks{list-style:none;margin:0 0 28px;padding:0}.rebate-checks li{border-bottom:1px solid #ffffff50;margin-bottom:24px;padding:0 0 24px 44px;position:relative}.rebate-checks li:before{content:'✓';color:var(--green);position:absolute;left:0;font-size:30px}.rebate-checks h3{font-size:30px;margin-bottom:12px}.rebate-checks p{font-size:16px;margin:0}.rebate-filter{background:#f2f3ed;padding:28px;border-radius:12px;margin-bottom:32px}.rebate-filter label{display:block;font-weight:700;margin-bottom:12px}.rebate-filter select{width:100%;max-width:680px;padding:14px;border:1px solid var(--teal);border-radius:6px;background:var(--warm);color:var(--charcoal);min-height:52px}.rebate-filter p{font-size:14px;margin:16px 0 0;max-width:none}.rebate-program-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}.rebate-program{border:1px solid var(--teal);border-radius:16px;padding:28px;display:flex;flex-direction:column}.rebate-program[hidden]{display:none}.rebate-kind{font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;margin-bottom:16px;color:var(--teal)}.rebate-program h3{font-size:32px;margin-bottom:16px}.rebate-program>p:not(.rebate-kind){font-size:16px}.rebate-program a{margin-top:auto;display:inline-flex;gap:10px;align-items:center;min-height:44px;font-size:14px}.rebate-program-action{text-align:center;margin-top:36px}.rebate-program-action :global(.actions){justify-content:center}.rebate-program-action p{max-width:none}.rebate-money{counter-reset:money;list-style:none;padding:0;margin:0}.rebate-money li{counter-increment:money;position:relative;padding:0 0 24px 54px;margin-bottom:24px;border-bottom:1px solid #c8c2b9}.rebate-money li:before{content:'0' counter(money);position:absolute;left:0;font:600 32px/1.1 Cormorant,Georgia,serif;color:var(--teal)}.rebate-money h3{font-size:30px;margin-bottom:12px}.rebate-money p,.rebate-budget-note p{font-size:16px;margin:0}.rebate-budget-note{border-left:3px solid var(--green);padding-left:24px;margin:28px 0}.rebate-budget-note h3{font-size:28px;margin-bottom:12px}.rebate-process{list-style:none;padding:0;margin:0}.rebate-process li{display:grid;grid-template-columns:64px 1fr;gap:24px;padding:24px 0;border-top:1px solid #7b8e36}.rebate-process li>span{font:600 52px/1 Cormorant,Georgia,serif;color:var(--teal)}.rebate-process h3{font-size:30px;margin-bottom:12px}.rebate-process p{font-size:16px;margin:0}.rebate-services{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}.rebate-services a{display:flex;align-items:center;justify-content:space-between;border:1px solid var(--teal);border-radius:10px;min-height:76px;padding:20px;gap:18px;font-weight:600;text-decoration:none}.rebate-services a:hover{background:#f2f3ed;text-decoration:underline}
@media(max-width:1100px){.rebate-story{gap:40px}.rebate-program-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.rebate-services{grid-template-columns:repeat(2,1fr)}}
@media(max-width:767px){.rebate-story,.rebate-program-grid,.rebate-services{grid-template-columns:1fr;gap:32px}.rebate-intro{margin-bottom:32px}.rebate-standard .hero h1{font-size:48px}.rebate-filter{padding:24px}.rebate-filter select{font-size:14px}.rebate-process li{grid-template-columns:48px 1fr;gap:18px}.rebate-process li>span{font-size:44px}.rebate-money li{padding-left:44px}.rebate-program{padding:24px}}
</style>
