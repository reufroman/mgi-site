---
import type {Content,Route} from '../data/types';
import {photos,requestHref} from '../data/catalog.mjs';
import Photo from './Photo.astro';
import PrimaryActions from './PrimaryActions.astro';
import CredentialLogos from './CredentialLogos.astro';
interface Props {content:Content;route:Route;}
const {content,route}=Astro.props;
const request=requestHref(route);
const pictures=photos(route.page_id);
const moment=(id:string)=>pictures.find(p=>p?.placement_id===id);
// Draft only. Jesse's Oct 12 flyer, message 1a1312a661fdc4dc.
const ductless={annual:128,additionalHead:65,diagnostic:69,regularDiagnostic:89,repairDiscount:15,equipmentDiscount:3,regularAfterHours:289};
const benefits=[['Two seasonal visits','One AC tune-up and one furnace tune-up each year.'],['$69 diagnostic charge','A diagnostic charge still applies. Repairs are separate.'],['15% repair discount','The public offer lists 15% off repair fees.'],['3% equipment discount','The public offer lists 3% off new equipment and installation.']];
const tuneups=[
 {id:'ac-tune-up',title:'Your VIP AC tune-up includes.',icon:'❄',count:12,intro:'A closer look at cooling, airflow, electrical parts, and water drainage.',groups:[
 {title:'Airflow and cooling',items:['Check the air filter.','Close the humidifier bypass damper, if fitted.','Inspect the indoor cooling coil and refrigerant line.','Run the system until operation settles.','Record total external static pressure: resistance to airflow.','Verify airflow against the equipment requirement.']},
 {title:'Electrical parts and drainage',items:['Inspect disconnect fuses.','Inspect electrical connections.','Inspect the outdoor fan motor.','Measure compressor electrical draw.','Inspect the condensate drain line.','Inspect the condensate pump, if fitted.']}
 ]},
 {id:'furnace-tune-up',title:'Your VIP furnace tune-up includes.',icon:'♨',count:17,intro:'A closer look at ignition, heating operation, safety devices, and the parts that move air.',groups:[
 {title:'Ignition, combustion, and safety',items:['Inspect and adjust furnace safety devices.','Test ignition.','Inspect the pilot, if fitted; clean the flame sensor.','Measure and record gas pressure at the burners; adjust as required.','Inspect burners.','Inspect venting.','Measure carbon monoxide levels.','Inspect carbon monoxide detectors.']},
 {title:'Air movement and heating operation',items:['Inspect electrical connections.','Inspect the blower compartment.','Inspect motors; lubricate where required.','Check furnace cycling.','Measure steady-state temperature rise.','Measure and record furnace and exhaust-fan current and voltage.','Inspect condensate drain and pump, if fitted.','Change the filter; confirm the filter supplied.','Inspect and calibrate controls.']}
 ]}
];
---
<article class="vip-standard">
<section class="hero"><div class="wrap"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">VIP Membership</span></nav>
<div class="hero-grid"><div><h1>{content.title}</h1><p class="lede">{content.summary}</p><PrimaryActions label="Explore membership" href="#membership-options"/></div><Photo image={moment('vip-opening')} caption="Keep a little room to dance." eager tilt={-2}/></div><CredentialLogos/></div></section>
<section class="section dark"><div class="wrap"><div class="vip-intro"><h2>A care plan for the home you enjoy.</h2><p>Plan routine care for your heating and cooling. Keep any extra repair work a separate choice.</p></div><div class="vip-story"><Photo image={moment('vip-benefits')} caption="Make room for a little flour." tilt={2}/><div class="vip-benefits">{benefits.map(([heading,body])=><div><span class="vip-check" aria-hidden="true">✓</span><div><h3>{heading}</h3><p>{body}</p></div></div>)}</div></div></div></section>
<section class="section" id="membership-options" tabindex="-1" aria-labelledby="membership-heading"><div class="wrap"><div class="vip-intro"><h2 id="membership-heading">VIP Comfort Club. Choose how to pay.</h2><p>MGI’s public offer lists annual and monthly payment options. Compare the totals before joining.</p></div><div class="vip-prices"><div><h3>Pay annually</h3><p class="vip-price">$225<span> per year</span></p><p>Published annual price.</p></div><div><h3>Pay monthly</h3><p class="vip-price">$20<span> per month</span></p><p>Twelve payments total <strong>$240</strong>, which is $15 more than the listed annual price.</p></div></div><div class="vip-terms"><h3>Know the terms before you join.</h3><ul><li>Confirm which systems and how many units the price covers.</li><li>Check discount exclusions and whether other offers can be combined.</li><li>Ask how billing, renewal, and cancellation work for your payment choice.</li></ul><p>The public plan also lists priority scheduling and no emergency/after-hours fee. Confirm availability and which charges the waiver covers. Membership is not a confirmed emergency appointment.</p><a href="https://mgiheatingandair.com/vip-membership/" rel="noopener noreferrer">View the published offer <span aria-hidden="true">↗</span></a></div><div class="vip-actions"><PrimaryActions label="Ask about joining" href={request}/></div><aside class="vip-review-note">Prices and benefits reflect the published offer checked October 8, 2026. Ask MGI to confirm the current price, enrollment terms, scheduling availability, and fee limits before joining.</aside></div></section>
<section class="section vip-canvas" id="ductless-vip" aria-labelledby="ductless-heading"><div class="wrap">
<div class="vip-intro"><p class="eyebrow">Ductless plan, draft for Jesse</p><h2 id="ductless-heading">Ductless VIP membership</h2><p>From MGI's October 12, 2026, mini-split membership flyer. Terms still need Jesse's confirmation.</p></div>
<div class="vip-prices"><div><h3>Outdoor unit and one indoor head</h3><p class="vip-price">${ductless.annual}<span> a year</span></p><p>Each additional head is ${ductless.additionalHead}. The flyer does not state how often that added charge is billed.</p><p>Two cleanings a year.</p></div><div><h3>Benefits in the flyer</h3><ul><li>${ductless.diagnostic} diagnostic, waived with repair. Regular price: ${ductless.regularDiagnostic}.</li><li>{ductless.repairDiscount}% off the repair fee.</li><li>{ductless.equipmentDiscount}% off new equipment and installation.</li><li>No emergency or after-hours fee. Weekends and holidays are not included. Regular price: ${ductless.regularAfterHours}.</li></ul></div></div>
<aside class="vip-review-note"><strong>Jesse, before this goes live:</strong> confirm added-head billing, which heads each cleaning covers, weekend and holiday limits, renewal, cancellation, and eligibility. The flyer says the diagnostic is waived with repair. The standard plan above says a diagnostic still applies. Please confirm which plan gets the waiver.</aside>
<div class="vip-actions"><PrimaryActions label="Ask about ductless VIP" href={request}/></div>
</div></section>
<section class="section vip-canvas" id="vip-tune-ups" aria-labelledby="vip-tuneup-heading"><div class="wrap">
<div class="vip-intro"><h2 id="vip-tuneup-heading">What your VIP Membership tune-ups include.</h2><p>We check as much as your equipment and access allow. Each visit follows a checklist, so the care goes beyond a quick look.</p></div>
<div class="vip-tuneups">{tuneups.map(t=><section class="vip-tuneup" id={t.id} aria-labelledby={`${t.id}-heading`}><header><span class="vip-tuneup-icon" aria-hidden="true">{t.icon}</span><div><p class="vip-tuneup-kicker">{t.count} published checklist items</p><h3 id={`${t.id}-heading`}>{t.title}</h3><p>{t.intro}</p></div></header><div class="vip-checklist-groups">{t.groups.map(g=><div><h4>{g.title}</h4><ul>{g.items.map(item=><li><span aria-hidden="true">✓</span><span>{item}</span></li>)}</ul></div>)}</div></section>)}</div>
<p class="vip-checklist-note">Checks depend on the equipment installed and safe access. A part that is not fitted cannot be checked. The AC airflow check uses the equipment’s required range; the published list gives 350–450 cubic feet per minute for each ton of cooling capacity. Repairs and extra work need a separate scope and price.</p>
<div class="vip-findings vip-story"><Photo image={moment('vip-care')} caption="Take time for a little twirl." tilt={-2}/><div><h3>Know what we checked. Know what comes next.</h3><p>Ask your technician to walk you through the findings, including any part that could not be checked.</p><ul><li>What is working as expected?</li><li>What needs attention, and why?</li><li>What would any recommended work include and cost?</li></ul><p>Decide on extra work after you understand it. A tune-up does not guarantee against a breakdown.</p><a href="/services/hvac-maintenance/">Explore HVAC maintenance <span aria-hidden="true">↗</span></a></div></div>
</div></section>
<section class="section green"><div class="wrap"><div class="vip-intro"><h2>From joining to a clearer care plan.</h2><p>Understand the plan, arrange the visits, and decide on any further work after you see the findings.</p></div><div class="vip-story"><Photo image={moment('vip-process')} caption="Make room for a little adventure." tilt={2}/><ol class="vip-steps">{content.sections.map((s,i)=><li><span aria-hidden="true">{String(i+1).padStart(2,'0')}</span><div><h3>{s.heading}</h3><p>{s.body}</p></div></li>)}</ol></div></div></section>
<section class="section"><div class="wrap"><div class="vip-intro"><h2>Need a repair today?</h2><p>Start with the problem. You can ask about membership after the immediate need is clear.</p></div><nav class="vip-paths" aria-label="Repair services"><a href="/services/furnace-repair/">Furnace repair ↗</a><a href="/services/ac-repair/">AC repair ↗</a><a href="/services/emergency-hvac-service/">Urgent HVAC help ↗</a></nav></div></section>
<section class="section vip-canvas"><div class="wrap"><div class="vip-intro"><h2>VIP Membership questions.</h2></div><div class="faq">{content.faqs.map(f=><details><summary>{f.question}</summary><p>{f.answer}</p></details>)}</div></div></section>
<section class="section dark"><div class="wrap"><div class="vip-intro"><h2>Plan the care. Make room for life at home.</h2><p>Your home has more going on than heating and cooling. Start with a care plan you understand.</p></div><div class="vip-story"><Photo image={moment('vip-close')} caption="Stay for another chapter." tilt={-2}/><div><h3>Let’s find out if membership fits.</h3><p>Tell MGI about your heating and cooling equipment. Ask for the current plan terms, compare the payment choices, and arrange the care that makes sense for your home.</p><PrimaryActions dark label="Ask about VIP Membership" href={request}/><p class="small-copy">The office will confirm membership details and appointments. An inquiry does not enroll you.</p></div></div></div></section>
</article>
<style>
.vip-tuneups{display:grid;gap:32px}.vip-tuneup{border:1px solid #c2ccc8;border-radius:20px;background:white;overflow:hidden}.vip-tuneup header{display:flex;gap:24px;align-items:center;background:#194f5c;color:white;padding:32px}.vip-tuneup header h3{color:white;margin:4px 0 12px;font-size:32px}.vip-tuneup header p{margin:0}.vip-tuneup-icon{display:grid;place-items:center;flex:0 0 76px;height:76px;border-radius:50%;background:#afc257;color:#194f5c;font-size:42px}.vip-tuneup-kicker{font-size:14px;letter-spacing:.04em}.vip-checklist-groups{display:grid;grid-template-columns:1fr 1fr;gap:40px;padding:32px}.vip-checklist-groups h4{font-size:20px;color:#194f5c;margin:0 0 18px}.vip-checklist-groups ul{list-style:none;padding:0;margin:0}.vip-checklist-groups li{display:flex;gap:12px;padding:12px 0;border-bottom:1px solid #e1e4dd;margin:0}.vip-checklist-groups li>span:first-child{color:#194f5c;font-weight:700}.vip-checklist-note{margin:28px 0 0;font-size:15px}.vip-findings{margin-top:64px}@media(max-width:767px){.vip-tuneup header{padding:24px;align-items:flex-start;gap:16px}.vip-tuneup-icon{flex-basis:52px;height:52px;font-size:30px}.vip-tuneup header h3{font-size:26px}.vip-checklist-groups{grid-template-columns:1fr;gap:28px;padding:24px}.vip-findings{margin-top:40px}}.vip-intro{text-align:center;margin-bottom:48px}.vip-intro h2,.vip-intro p{max-width:none}.vip-intro p{margin:0}.vip-standard .hero h1{max-width:18ch}.vip-story{display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center}.vip-benefits>div{display:flex;gap:22px;border-bottom:1px solid #ffffff55;padding:22px 0}.vip-check{color:var(--lime);font-size:36px}.vip-benefits h3,.vip-care h3{margin-top:0}.vip-benefits p{margin:0}.vip-prices{display:grid;grid-template-columns:1fr 1fr;gap:24px}.vip-prices>div{border:1px solid var(--teal);border-radius:18px;padding:32px}.vip-price{font-size:48px;font-weight:700;color:var(--teal);margin:12px 0}.vip-price span{font-size:18px;font-weight:400}.vip-terms{margin:32px 0;padding:28px;background:var(--canvas,#f1f3ec);border-radius:18px}.vip-actions{display:flex;justify-content:center}.vip-review-note{margin-top:24px;padding:12px 16px;border-left:3px solid var(--lime);font-size:14px}.vip-canvas{background:#f1f3ec}.vip-care{border-bottom:1px solid #d4cdc3;padding:16px 0;margin-bottom:24px}.vip-steps{padding:0;list-style:none}.vip-steps li{display:flex;gap:24px;border-top:1px solid #829540;padding:24px 0}.vip-steps li>span{font-family:var(--display);font-size:38px;color:var(--teal)}.vip-steps h3{margin-top:0}.vip-steps p{margin-bottom:0}.vip-paths{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.vip-paths a{padding:22px;border:1px solid var(--teal);border-radius:12px;text-decoration:none;font-weight:700}.vip-standard ul{padding-left:22px}.vip-standard li{margin-bottom:12px}@media(max-width:767px){.vip-story,.vip-prices,.vip-paths{grid-template-columns:1fr}.vip-story{gap:40px}.vip-intro{margin-bottom:32px}.vip-prices>div{padding:24px}.vip-terms{padding:24px}.vip-price{font-size:42px}}
</style>
