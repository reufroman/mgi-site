---
import {byId} from '../data/catalog.mjs';
import {answerCategoryProfiles} from '../data/answer-categories.mjs';
import {libraryAnswerById} from '../data/answer-library.mjs';
interface Props {answer:any;presentation:any;}
const {answer,presentation}=Astro.props;
const minutes=Math.max(1,Math.ceil(answer.sourceMarkdown.split(/\s+/).length/220));
const headings=[...answer.bodyHtml.matchAll(/<h2>(.*?)<\/h2>/g)].map((m,i)=>({title:m[1].replace(/<[^>]+>/g,''),id:`answer-section-${i+1}`}));
let index=0;const html=answer.bodyHtml.replace(/<h2>/g,()=>`<h2 id="answer-section-${++index}">`);
const split=html.indexOf('<h2');const opening=split<0?html:html.slice(0,split);const body=split<0?'':html.slice(split);
const service=byId(presentation.cta.pageId);
const categoryId=Object.entries(answerCategoryProfiles).find(([,profile])=>profile.topics.includes(answer.topicId))?.[0];
const category=categoryId?byId(categoryId):null;
const related=presentation.related.map((id:string)=>({route:byId(id),answer:libraryAnswerById[id]})).filter((item:any)=>item.route&&item.answer);
---
<article class="answer-article" data-homeowner-guide={answer.sourceId} data-library-answer={answer.sourceId} data-source-id={answer.sourceId} data-source-hash={answer.sourceHash}>
 <div class="wrap">
  <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/answers/">Homeowner answers</a><span aria-hidden="true">/</span><span aria-current="page">{presentation.category}</span></nav>
  <header class="article-header"><p class="article-category">{presentation.category}</p><h1>{answer.title}</h1><p class="article-meta">Homeowner guide <span aria-hidden="true">·</span> {minutes} min read</p></header>
  <div class:list={["article-opening",{"article-safety":presentation.urgent}]}>{answer.sourceId==='MGI-001'&&<p class="safety-label">If you smell gas now</p>}<div class="answer-source" set:html={opening}/></div>
  <div class="article-grid"><div class="article-body"><div class="answer-source" set:html={body}/>
   {service&&<aside class="article-cta" aria-labelledby="article-next-heading" data-context-cta><p class="article-category">Your next step</p><h2 id="article-next-heading">{presentation.cta.heading}</h2><p>{presentation.cta.body}</p><a class="button" href={service.canonical_route}>{presentation.cta.label} <span aria-hidden="true">↗</span></a>{presentation.cta.note&&<p class="article-cta-note">{presentation.cta.note}</p>}</aside>}
  </div>{headings.length>0&&<aside class="article-sidebar" aria-label="Article navigation"><details open><summary>In this guide</summary><nav aria-label="In this guide"><ol>{headings.map(h=><li><a href={`#${h.id}`}>{h.title}</a></li>)}</ol></nav></details><div class="article-library"><h2>Another question about your home?</h2><p>Find answers by equipment or by what you notice.</p><a href={category?.canonical_route||`/answers/?topic=${answer.topicId}#situations`}>Browse {answer.topicLabel.toLowerCase()} answers <span aria-hidden="true">↗</span></a></div></aside>}</div>
  {related.length>0&&<section class="article-related" aria-labelledby="related-heading"><h2 id="related-heading">Keep exploring {answer.topicLabel.toLowerCase()}.</h2><div>{related.map((item:any)=><a href={item.route.canonical_route}><span>{item.answer.topicLabel}</span><h3>{item.answer.title}</h3><span aria-hidden="true">Read the guide ↗</span></a>)}</div></section>}
  <nav class="article-return" aria-label="Back to the library"><a href="/answers/">← All homeowner answers</a></nav>
 </div>
</article>
<style>
.answer-article{padding:36px 0 72px;background:var(--warm);color:var(--charcoal)}.article-header{max-width:1040px;padding:12px 0 36px}.article-header h1{font-size:clamp(38px,4.7vw,66px);line-height:1.08;max-width:none;margin:16px 0 22px}.article-category{font:700 13px/1.5 Manrope,Arial,sans-serif;letter-spacing:.05em;text-transform:uppercase;color:var(--teal);margin:0 0 14px}.article-meta{font-size:14px;color:#535954;margin:0}.article-meta span{margin:0 8px}.article-opening{max-width:900px;margin-bottom:44px}.article-safety{max-width:100%;padding:28px 32px;border-left:5px solid var(--teal);background:#f1f3ec;margin-bottom:52px}.safety-label{font-size:14px;text-transform:uppercase;letter-spacing:.04em;font-weight:800;color:var(--teal);margin:0 0 16px}.article-safety .answer-source{max-width:900px}.answer-source :global(p),.answer-source :global(li){font-size:17px;line-height:1.8;max-width:none}.answer-source :global(p){margin:0 0 22px}.answer-source :global(p:last-child){margin-bottom:0}.answer-source :global(table){width:100%;border-collapse:collapse;table-layout:fixed;margin:24px 0}.answer-source :global(th),.answer-source :global(td){border:1px solid #c7cfc1;padding:12px;text-align:left;vertical-align:top;overflow-wrap:anywhere;font-size:15px}.answer-source :global(th){background:#f1f3ec}.answer-source :global(ul){padding-left:24px;margin:20px 0}.answer-source :global(li){margin-bottom:10px}.answer-source :global(h2){font-size:34px;line-height:1.18;margin:42px 0 22px;max-width:none;scroll-margin-top:28px}.article-body>.answer-source :global(h2:first-child){margin-top:0}.answer-source :global(a){text-underline-offset:3px;overflow-wrap:anywhere}.article-grid:has(>.article-body:only-child){grid-template-columns:1fr;max-width:820px}.article-grid{display:grid;grid-template-columns:minmax(0,2.3fr) minmax(230px,1fr);gap:72px;align-items:start}.article-sidebar{position:sticky;top:28px;padding:24px;border-top:3px solid var(--teal);background:#f1f3ec}.article-sidebar summary{font-weight:800;font-size:16px;cursor:pointer;padding:4px 0 12px}.article-sidebar ol{list-style:none;padding:0;margin:0}.article-sidebar li{border-top:1px solid #d0d7cb}.article-sidebar nav a{font-size:14px;line-height:1.6;display:block;padding:13px 0;text-decoration:none}.article-sidebar nav a:hover{text-decoration:underline}.article-library{border-top:1px solid #bbc6ba;margin-top:20px;padding-top:24px}.article-library h2{font-size:25px;line-height:1.2;margin:0 0 14px}.article-library p,.article-library a{font-size:14px;line-height:1.7}.article-library a{font-weight:700;display:inline-block;padding:8px 0}.article-cta{background:#eaf0dd;border-radius:14px;padding:32px;margin-top:40px;border-top:4px solid #afc34f}.article-cta h2{font-size:34px;line-height:1.2;margin:0 0 18px}.article-cta>p{font-size:16px;line-height:1.7}.article-cta .article-category{font-size:12px}.article-cta .button{font-size:15px}.article-cta .article-cta-note{font-size:13px;margin:18px 0 0}.article-related{border-top:1px solid #d0d2c7;margin-top:64px;padding-top:40px}.article-related>h2{font-size:38px;margin:0 0 26px}.article-related>div{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.article-related>div>a{display:flex;flex-direction:column;gap:16px;padding:24px;border:1px solid #c7cfc1;border-radius:12px;text-decoration:none}.article-related h3{font-size:24px;line-height:1.25;margin:0}.article-related span{font-size:12px;font-weight:700}.article-related span:last-child{margin-top:auto;padding-top:10px}.article-return{margin-top:32px}.article-return a{display:inline-block;padding:12px 0;font-size:15px;font-weight:700}.answer-article :global(a:focus-visible),.article-sidebar summary:focus-visible{outline:3px solid var(--teal);outline-offset:4px}
@media(max-width:900px){.article-grid{grid-template-columns:1fr;gap:36px}.article-sidebar{position:static;grid-row:1}.article-sidebar .article-library{display:none}.article-related>div{grid-template-columns:1fr}.article-related h3{font-size:26px}}
@media(max-width:767px){.answer-article{padding:24px 0 48px}.article-header h1{font-size:38px}.article-header{padding-bottom:28px}.article-safety{padding:22px 20px;margin-bottom:32px}.answer-source :global(p),.answer-source :global(li){font-size:16px;line-height:1.75}.answer-source :global(h2){font-size:30px}.article-cta{padding:24px}.article-cta h2{font-size:30px}.article-related{margin-top:44px}.article-related>h2{font-size:32px}.article-sidebar{padding:20px}}
</style>
