---
import type {Route,Content} from '../data/types';
import {photos,byId,review} from '../data/catalog.mjs';
import site from '../data/site.json';
import Photo from './Photo.astro';
import CredentialLogos from './CredentialLogos.astro';
import ServiceIcon from './ServiceIcon.astro';
import ServiceTitanBooking from './ServiceTitanBooking.astro';
interface Props {route:Route;content:Content;}
const {route,content}=Astro.props;
const contact=route.page_id==='ST-003',status=route.page_id==='ST-018';
const pictures=photos(route.page_id);
const phone='tel:+19702871673';
const request=byId('ST-004');
const emergency=byId('ST-079');
const steps=[{title:'Tell us what you need.',body:'Share the address, what changed, and a way to reach you. You do not need to name the part.'},{title:'Talk through the visit.',body:'The office checks service at your address, availability, and visit details with you.'},{title:'Confirm the plan.',body:'Agree on the appointment time and any visit charges before the visit.'}];
---
<article class="contact-booking">
<section class="hero"><div class="wrap"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">{contact?'Contact':status?'Request status':'Request service'}</span></nav>
{contact?<><div class="hero-grid"><div><p class="contact-eyebrow">Contact MGI Heating and Air</p><h1>{content.title}</h1><p class="lede">{content.summary}</p><div class="actions"><a class="button" href={phone}><ServiceIcon name="phone"/>Call {site.phone}</a>{request&&<a class="button outline" href={request.canonical_route}>Request service ↗</a>}</div><p class="small-copy">Have a question before you plan a visit? Start with a call.</p></div><Photo image={pictures[0]} eager caption="Back to your kind of day."/></div><CredentialLogos/></>:<div class="booking-opening"><p class="contact-eyebrow">MGI Heating and Air</p><h1>{content.title}</h1><p class="lede">{content.summary}</p></div>}
</div></section>
{contact?<>
<section class="section dark"><div class="wrap"><div class="contact-intro"><h2>A conversation is a useful first step.</h2><p>Choose the way to reach us that fits what you need.</p></div><div class="contact-story"><Photo image={pictures[1]} caption="More time for little moments." tilt={2}/><div class="contact-options"><div><ServiceIcon name="phone"/><h3>Talk with MGI.</h3><p>Ask about a repair concern, a new system, or routine care.</p><a class="contact-phone" href={phone}>{site.phone}</a></div><div><h3>Share the details online.</h3><p>Send your address and what you have noticed so the office has a starting point.</p>{request&&<a class="button light" href={request.canonical_route}>Start a service request ↗</a>}</div><div><h3>Our business address</h3><p>{site.address}</p></div></div></div></div></section>
<section class="section"><div class="wrap"><div class="contact-intro"><h2>Start with what you notice.</h2><p>A simple description helps the office understand your concern.</p></div><div class="contact-story"><div><ul class="contact-checks"><li><strong>What changed?</strong> No heat, warm air, a leak, or a question about new equipment.</li><li><strong>When did it start?</strong> Tell us if the problem comes and goes.</li><li><strong>Where is the home?</strong> Have the street address and any access details ready.</li></ul>{byId('ST-006')&&<a href="/service-area/">Explore service areas ↗</a>}</div><Photo image={pictures[2]} caption="A little more time together."/></div></div></section>
<section class="section contact-canvas"><div class="wrap"><div class="contact-intro"><h2>From your first question to a visit.</h2></div><div class="contact-story"><Photo image={pictures[3]} caption="Room for the things you love." tilt={2}/><ol class="contact-steps">{steps.map(step=><li><h3>{step.title}</h3><p>{step.body}</p></li>)}</ol></div></div></section>
<section class="section dark"><div class="wrap"><div class="contact-intro"><h2>Let’s get your home back on track.</h2><p>Tell us what you need. We’ll start with the next step.</p></div><div class="contact-story"><div><h3>Ready to talk?</h3><div class="actions"><a class="button light" href={phone}>Call {site.phone}</a>{request&&<a class="button outline" href={request.canonical_route}>Request service ↗</a>}</div>{emergency&&<p><a href={emergency.canonical_route}>Need urgent HVAC help? ↗</a></p>}</div><Photo image={pictures[4]} caption="Make time for home."/></div></div></section>
</>:status?<section class="section"><div class="wrap status-card"><ServiceIcon name="care"/><h2>No request receipt is available here.</h2><p>Opening this page does not show that a request was received. If you used the scheduler, check the message shown there. Your appointment is pending confirmation.</p><div class="actions">{request&&<a class="button" href={request.canonical_route}>Return to the request form ↗</a>}<a class="button outline" href={phone}>Call MGI</a></div></div></section>:<section class="section booking-section"><div class="wrap booking-grid"><div id="request-form"><ServiceTitanBooking/></div><aside class="booking-support"><h2>What happens next?</h2><ol class="contact-steps">{steps.slice(1).map(step=><li><h3>{step.title}</h3><p>{step.body}</p></li>)}</ol><div class="booking-call"><h3>Prefer to talk?</h3><a class="contact-phone" href={phone}>{site.phone}</a><p>Call with a question about the work or your address.</p></div>{emergency&&<a href={emergency.canonical_route}>Explore urgent HVAC help ↗</a>}<p class="small-copy">For immediate danger, leave the area and contact emergency services or your utility from a safe place. Do not wait for a form reply.</p></aside></div></section>}
</article>
<style>
.contact-eyebrow{font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--teal)}.contact-intro{text-align:center;margin-bottom:40px}.contact-intro h2,.contact-intro p{max-width:none}.contact-story{display:grid;grid-template-columns:1fr 1fr;gap:72px;align-items:center}.contact-story h3,.booking-support h3{font-size:28px}.contact-options>div+div{border-top:1px solid #ffffff55;margin-top:26px;padding-top:20px}.contact-options :global(svg){width:42px;height:42px;color:#afc34f}.contact-phone{font-size:25px;font-weight:700;display:inline-block;padding:8px 0}.contact-canvas{background:#f1f3ec}.contact-checks{padding-left:24px}.contact-checks li{padding:18px 0;border-bottom:1px solid #bbc5be}.contact-checks strong{display:block;color:var(--teal)}.contact-steps{padding-left:26px}.contact-steps li{padding:12px 0 18px 12px;border-bottom:1px solid #bbc5be}.contact-steps h3{margin:0 0 12px}.contact-steps p{margin:0}.booking-opening{max-width:850px}.booking-opening h1{font-size:clamp(38px,4vw,58px)}.contact-booking:has(.booking-opening) .hero{padding-bottom:24px}.booking-section{padding-top:24px;background:linear-gradient(#fff 0,#f1f3ec 100%)}.booking-grid{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(0,1fr);gap:64px;align-items:start}.booking-support{padding-top:24px}.booking-support h2{font-size:32px}.booking-call{margin:28px 0;padding:22px;background:#f1f3ec;border-radius:12px}.status-card{max-width:850px;border:1px solid #bcc8c0;border-radius:16px;padding:36px}.status-card> :global(svg){width:48px;height:48px;color:var(--teal)}.contact-booking .dark .button.outline{border-color:white;color:white}.contact-booking a:focus-visible{outline:3px solid currentColor;outline-offset:4px}
@media(max-width:767px){.contact-story,.booking-grid{grid-template-columns:1fr;gap:32px}.booking-support{padding-top:0}.contact-intro{margin-bottom:28px}.status-card{width:calc(100% - 40px);padding:24px}.contact-phone{font-size:23px}}
</style>
