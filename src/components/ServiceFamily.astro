---
import type Profiles from '../data/repair-family-rollout.json';
import type Proof from '../data/home-proof.json';
import type {Route,Content} from '../data/types';
import Photo from './Photo.astro';
import PrimaryActions from './PrimaryActions.astro';
import CredentialLogos from './CredentialLogos.astro';
import ServiceIcon from './ServiceIcon.astro';
import {photos,requestHref,contextFor} from '../data/catalog.mjs';
import {serviceFamilyContent} from '../data/service-family-rollout.mjs';
interface Props {route:Route;content:Content;}
const {route,content}=Astro.props;
type FamilyProfile=typeof Profiles['ST-059'] & {localContext?:{heading:string;intro:string;body:string;places?:string[]};faqHeading?:string;kind?:string;financing?:boolean;quoteLimit?:string;servicePaths?:{href:string;title:string;body:string}[]};
const data=serviceFamilyContent(route.page_id,content) as Content & {familyStandard:FamilyProfile;relevantReviews?:typeof Proof.reviews};
const copy=data.familyStandard!;
const pictures=photos(route.page_id);
const moment=(name:string)=>pictures.find(p=>p?.placement_id===name);
const request=requestHref(route);
const local=contextFor(route);
const technical=data.sections[2];
const findings=data.sections[1];
const lines=(text:string)=>text.split(/(?<=[.!?])\s+/);
const reviews=data.relevantReviews||[];
const captions=['A little time together.','Room for the things you enjoy.','Make a little room for the good parts.','Keep some time for each other.'];
---
<article class="repair-family" data-family-standard={copy.kind||'repair'}>
<section class="hero"><div class="wrap"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/services/">Services</a><span aria-hidden="true">/</span><>{local&&<><a href={local.area.canonical_route}>{local.area.name.replace('HVAC Services in ','')}</a><span aria-hidden="true">/</span></>}</><span aria-current="page">{route.name}</span></nav><div class="hero-grid"><div><h1>{data.title}</h1><p class="lede">{data.summary}</p><PrimaryActions href={request} label={data.ctaLabel}/></div><Photo image={moment('service-support')} eager tilt={-2}/></div><CredentialLogos/>{copy.safety&&<aside class="repair-safety" aria-label="Emergency safety"><p>{copy.safety}</p><strong>Do not wait for an HVAC visit.</strong></aside>}</div></section>
<section class="section dark" id="answer"><div class="wrap"><div class="family-intro"><h2>{copy.preparationHeading}</h2><p>{copy.preparationBody}</p></div><div class="family-story"><Photo image={moment('recognition-moment')} caption={captions[0]} tilt={2}/><div class="preparation">{copy.preparation.map((item,index)=><div><span class="family-icon" aria-hidden="true"><ServiceIcon name={['care','air','phone'][index]}/></span><div><h3>{item.title}</h3><ul>{lines(item.body).map(line=><li>{line}</li>)}</ul></div></div>)}</div></div></div></section>
{reviews.length>0&&<section class="section customer-feedback"><div class="wrap"><div class="family-intro"><h2>A homeowner’s experience with MGI.</h2><p>General MGI customer feedback, shared on Google.</p></div><div class="review-grid">{reviews.map(record=><figure class="review-card"><span class="stars" aria-label={`${record.rating} out of 5 stars`}>★★★★★</span><blockquote>{record.text}</blockquote><figcaption><div class="reviewer-identity"><img class="reviewer-avatar" src={record.reviewerImage} alt="" width="48" height="48" loading="lazy" referrerpolicy="no-referrer"/><strong>{record.name}</strong></div><span>Google review · {new Date(record.date+'T12:00:00').toLocaleDateString('en-US',{month:'short',year:'numeric'})}</span><a href={record.source} target="_blank" rel="noopener noreferrer">Read on Google ↗</a></figcaption></figure>)}</div></div></section>}
<section class="section family-tint"><div class="wrap"><div class="family-intro"><h2>{copy.technicalHeading}</h2><p>{technical.body}</p>{copy.kind==='maintenance'&&<p class="technical-scope">These are general care examples, not a list of what MGI includes. Ask what your visit covers.</p>}</div><ul class="technical-cards">{technical.bullets?.map((body,index)=><li><span class="family-icon" aria-hidden="true"><ServiceIcon name={['care','air','pump','heat'][index]}/></span><div><h3>{copy.technicalTitles[index]}</h3><p>{body}</p></div></li>)}</ul></div></section>
<section class="section"><div class="wrap"><div class="family-intro"><h2>{copy.findingsHeading}</h2></div><div class="family-story reverse-story"><Photo image={moment('choice-moment')} caption={captions[1]} tilt={-2}/><div><ol class="findings">{lines(findings.body).map(line=><li><p>{line}</p></li>)}</ol><PrimaryActions href={request} label={data.ctaLabel}/><nav class="reading-paths" aria-label="Further service guidance"><a class="button outline" href={copy.comparisonHref}>{copy.comparisonLabel} <span aria-hidden="true">↗</span></a><a href={copy.replacementHref}>{copy.replacementLabel} <span aria-hidden="true">↗</span></a></nav></div></div></div></section>
<section class="section quote-section"><div class="wrap"><div class="family-intro"><h2>{copy.quoteHeading}</h2><p>{copy.quoteIntro}</p></div>{copy.localContext&&<aside class="family-local"><h3>{copy.localContext.heading}</h3>{copy.localContext.intro&&<p>{copy.localContext.intro}</p>}<p>{copy.localContext.body}</p></aside>}<div class="quote-grid">{copy.servicePaths ? copy.servicePaths.map(item=><div><h3><a href={item.href}>{item.title} <span aria-hidden="true">↗</span></a></h3><p>{item.body}</p></div>) : copy.quoteQuestions.map(item=><div><h3>{item.title}</h3><p>{item.body}</p></div>)}</div>{copy.kind!=='hub'&&<p class="quote-limit">{copy.quoteLimit||'Get the full parts and labor price, visit charge, and any separate work clear before you approve the repair.'}</p>}{copy.financing&&<div class="project-finance"><h3>A payment plan for the project you choose.</h3><p>Financing can spread the upfront cost over monthly payments. Compare the payment, total cost, and terms before choosing. Approval and terms apply.</p><a class="button light" href={'/financing/?'+new URLSearchParams({service:route.name}).toString()}>Explore financing information <span aria-hidden="true">↗</span></a></div>}</div></section>
<section class="section green"><div class="wrap"><div class="family-intro"><h2>{copy.processHeading}</h2><p>{copy.processBody}</p></div><div class="family-story"><div><ol class="process">{copy.steps.map(([heading,body])=><li><h3>{heading}</h3><p>{body}</p></li>)}</ol><PrimaryActions href={request} label={data.ctaLabel}/></div><Photo image={moment('process-moment')} caption={captions[2]} tilt={2}/></div></div></section>
<section class="section"><div class="wrap"><div class="family-intro"><h2>{'faqHeading' in copy ? copy.faqHeading : <>Questions about {route.name.toLowerCase().replace(/\bac\b/g,'AC').replace(/\bhvac\b/g,'HVAC')}.</>}</h2></div><div class="faq">{data.faqs.map(f=><details><summary>{f.question}</summary><p>{f.answer}</p></details>)}</div></div></section>
<section class="closing"><div class="wrap"><div class="family-intro"><h2>{copy.closeHeading}</h2><p>{copy.closeBody}</p></div><div class="family-story"><Photo image={moment('closing-moment')} caption={captions[3]} tilt={-2}/><PrimaryActions dark href={request} label={data.ctaLabel}/></div><p class="origin-note">Lifestyle scenes are AI-generated illustrations, not photographs of MGI customers or completed work.</p></div></section>
</article>
<style>
.family-local{margin:0 0 44px;border-top:1px solid #70969b;padding-top:24px}.family-local h3{font-size:30px}.family-local p{font-size:16px}.repair-family .hero{padding-bottom:48px}.repair-family h1{max-width:none;font-size:clamp(40px,4.6vw,68px)}.family-intro{text-align:center;width:100%;margin-bottom:44px}.family-intro h2,.family-intro p{max-width:none}.family-intro p{margin-bottom:0}.family-story{display:grid;grid-template-columns:1fr 1.1fr;gap:64px;align-items:center}.family-story>*{min-width:0}.family-story :global(.polaroid){width:calc(100% - 24px);margin:12px}.family-story :global(.primary-actions){justify-content:flex-start}.reverse-story> :global(.polaroid){order:2}.preparation>div{display:grid;grid-template-columns:80px 1fr;gap:24px;padding:24px 0;border-bottom:1px solid #ffffff55}.preparation>div:first-child{padding-top:0}.family-icon{display:grid;place-items:center;width:72px;height:72px;border-radius:50%;background:var(--green);color:var(--teal)}.family-icon :global(svg){width:36px;height:36px}.preparation h3{font-size:30px;margin-bottom:12px}.preparation ul{padding-left:18px;font-size:16px;margin:0}.preparation li+li{margin-top:10px}.family-tint{background:#f2f3ed}.technical-cards{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:1fr 1fr;gap:24px}.technical-cards li{display:grid;grid-template-columns:72px 1fr;gap:24px;padding:28px;border-radius:14px;background:var(--warm)}.technical-cards h3{font-size:28px}.technical-cards p{font-size:16px;margin-bottom:0}.findings{padding-left:28px;margin:0 0 28px}.findings li{border-bottom:1px solid #c9c4b8;padding:16px 0 16px 10px}.findings li::marker{font:600 30px Cormorant,Georgia,serif;color:var(--teal)}.findings p{margin:0}.reading-paths{display:flex;flex-wrap:wrap;gap:20px;margin-top:28px;align-items:center}.reading-paths a{min-height:44px;display:inline-flex;align-items:center}.quote-section{background:#103c46;color:var(--warm)}.quote-section h2,.quote-section h3{color:var(--warm)}.quote-grid{display:grid;grid-template-columns:1fr 1fr;gap:28px}.quote-grid>div{border-top:1px solid #70969b;padding:24px 0}.quote-grid h3{font-size:28px}.quote-grid p{font-size:16px;margin:0}.project-finance{margin-top:32px;border-top:1px solid #70969b;padding-top:24px}.project-finance p{font-size:16px}.quote-section a{color:var(--warm)}.quote-section a:focus-visible{outline-color:var(--warm)}.quote-section :global(.button.light){color:var(--teal)}.quote-limit{margin:28px 0 0;border-top:1px solid #70969b;padding-top:24px;font-size:15px}.repair-family .process{grid-template-columns:1fr;gap:24px;margin-bottom:28px}.repair-family .process h3{font-size:30px}.repair-family .process p{margin-bottom:0}.repair-family :global(.button){max-width:100%;white-space:normal}.repair-safety{margin:32px 0 0;border-left:4px solid var(--teal);padding:24px;background:#f1f3ec}.repair-safety p,.repair-safety strong{font-size:16px}.repair-safety p{margin-bottom:12px}.customer-feedback{background:#f2f3ed}.customer-feedback .review-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));max-width:800px;margin:auto}.origin-note{font-size:13px;margin:40px 0 0}.closing .family-story :global(.primary-actions){justify-content:center}
@media(max-width:1000px){.family-story{gap:40px}.technical-cards li{grid-template-columns:48px 1fr;gap:20px;padding:24px}.technical-cards .family-icon{width:48px;height:48px}}
@media(max-width:767px){.family-story{grid-template-columns:1fr;gap:32px}.reverse-story> :global(.polaroid){order:0}.preparation>div{grid-template-columns:64px 1fr;gap:16px}.family-icon{width:56px;height:56px}.preparation h3,.technical-cards h3,.quote-grid h3,.repair-family .process h3{font-size:26px}.technical-cards,.quote-grid{grid-template-columns:1fr}.technical-cards li{grid-template-columns:48px 1fr}.family-intro{margin-bottom:32px}.family-story :global(.primary-actions){justify-content:center}.repair-family h1{font-size:40px}.customer-feedback .review-grid{grid-template-columns:1fr}}
</style>
