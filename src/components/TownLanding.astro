---
import type {Route,Content} from '../data/types';
import {photos,byId,pages,contextFor,requestHref} from '../data/catalog.mjs';
import Photo from './Photo.astro';
import CredentialLogos from './CredentialLogos.astro';
import PrimaryActions from './PrimaryActions.astro';
import ServiceIcon from './ServiceIcon.astro';
import ServiceAreaMap from './ServiceAreaMap.astro';
interface Props {route:Route;content:Content & {areaHub?:any};}
const {route,content}=Astro.props;const hub=content.areaHub;const {index,town}=hub;
const photo=(slot:string)=>photos(route.page_id).find(p=>p?.placement_id===`area-${slot}`);
const local=pages.filter(p=>p.family==='Service-town candidate'&&contextFor(p)?.area.page_id===route.page_id);
const serviceLink=(id:string)=>local.find(p=>contextFor(p)?.service.page_id===id)||byId(id);
const groups=[{name:'Furnaces',icon:'heat',ids:['ST-059','ST-060','ST-063']},{name:'Air conditioning',icon:'cool',ids:['ST-061','ST-062','ST-064']},{name:'Heat pumps',icon:'pump',ids:['ST-065','ST-066','ST-067']},{name:'Water heaters',icon:'water',ids:['ST-068','ST-069','ST-070']},{name:'Heat-pump water heaters',icon:'water',ids:['ST-071','ST-072','ST-073']},{name:'Mini splits',icon:'split',ids:['ST-074','ST-075','ST-076']},{name:'Indoor air quality',icon:'air',ids:['ST-077','ST-078']}].map(g=>({...g,links:g.ids.map((id,i)=>({route:serviceLink(id),label:g.name==='Indoor air quality'?(i===0?'Assessment':'Air purification'):['Repair','Replacement','Maintenance'][i]})).filter(l=>l.route)})).filter(g=>g.links.length);
const request=byId('ST-004')?requestHref(route):null;const urgent=serviceLink('ST-079');const vip=byId('ST-010');const newhome=byId('ST-011');const finance=byId('ST-007');const rebates=byId('ST-008');
const decisions=[{icon:'care',title:'Something stopped working.',body:'Describe the change and when it started. You do not need to know which part failed.'},{icon:'pump',title:'You are planning a change.',body:'Compare the findings, the work included, and the full project price before choosing equipment.'},{icon:'heat',title:'You want to keep up with care.',body:'Start with your equipment and the last visit you know about. Ask what the next tune-up covers.'}];
---
<article class="area-standard" data-area-hub={index?'index':town}>
<section class="hero"><div class="wrap"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span>{!index&&byId('ST-006')&&<><a href="/service-area/">Service areas</a><span aria-hidden="true">/</span></>}<span aria-current="page">{index?'Service areas':town}</span></nav><div class="hero-grid"><div><p class="area-eyebrow">{index?'Northern Colorado':`Heating and cooling in ${town}`}</p><h1>{content.title}</h1><p class="lede">{content.summary}</p>{index?<a class="button" href="#towns">Find your town <span aria-hidden="true">↓</span></a>:request&&<PrimaryActions href={request} label={`Request service in ${town}`}/>}<p class="area-small">Contact MGI to confirm the work, availability, and service at your address.</p></div><Photo image={photo('opening')} eager caption="A good place to come home to." tilt={-2}/></div><CredentialLogos/></div></section>
{index&&<section class="section area-map-wrap" id="towns"><div class="wrap"><ServiceAreaMap/></div></section>}
<section class="section dark" id="local-services"><div class="wrap"><div class="area-intro"><h2>{index?'Find the help your home needs.':`Find the right HVAC service in ${town}.`}</h2><p>Choose your equipment, then explore repair, replacement, or maintenance.</p></div><div class="area-service-grid">{groups.map(group=><details class="area-service-card" open><summary><ServiceIcon name={group.icon}/><h3>{group.name}</h3></summary><nav aria-label={`${group.name} services${index?'':` in ${town}`}`}>{group.links.map(link=><a href={link.route!.canonical_route}>{link.label}<span aria-hidden="true">↗</span></a>)}</nav></details>)}{urgent&&<details class="area-service-card" open><summary><ServiceIcon name="phone"/><h3>Emergency HVAC</h3></summary><div class="area-service-content"><p class="area-emergency-copy">Heating or cooling stopped? Find the next step for urgent help.</p><nav aria-label="Emergency HVAC service"><a href={urgent.canonical_route}>Explore urgent help <span aria-hidden="true">↗</span></a></nav></div></details>}</div><div class="area-story area-needs"><Photo image={photo('services')} caption="Make room for a little more together." tilt={2}/><div class="area-decision-list">{decisions.map(item=><div><span class="area-icon"><ServiceIcon name={item.icon}/></span><div><h3>{item.title}</h3><p>{item.body}</p></div></div>)}</div></div></div></section>
<section class="section area-canvas"><div class="wrap"><div class="area-intro"><h2>{index?'A project plan starts with your home.':`Plan equipment work in ${town}.`}</h2><p>For a replacement or new installation, get the property details into the plan before choosing the equipment.</p></div><div class="area-story"><div class="area-project"><h3>{index?'Check the details before you choose.':`Before equipment work at your ${town} home.`}</h3><p>{index?'Use your street address and current utility accounts to check project requirements and rebate options.':hub.propertyDetail}</p>{!index&&hub.sourceURLs.length>0&&town!=='Windsor'&&<a class="area-local-source" href={hub.sourceURLs.at(-1)} rel="noreferrer">Local project information <span aria-hidden="true">↗</span></a>}<ul><li>Include outdoor equipment placement and access in the plan.</li><li>Get the full scope and price, including any permit or other-trade work.</li></ul><div class="area-resource-links">{finance&&<a href={finance.canonical_route}>Explore financing ↗</a>}{rebates&&<a href={rebates.canonical_route}>Check rebate options ↗</a>}</div></div><Photo image={photo('project')} caption="Stay a little longer." tilt={-2}/></div></div></section>
<section class="section"><div class="wrap"><div class="area-intro"><h2>{index?'Settle in. Keep care simple.':`Make a care plan for your ${town} home.`}</h2><p>Useful records and regular care give you a clearer starting point for the next question.</p></div><div class="area-story"><Photo image={photo('care')} caption="Room for the everyday moments." tilt={2}/><div class="area-care">{newhome&&<div><h3>New to the home?</h3><p>Gather the manuals and service records you have. Use the first-days checklist to get familiar with the equipment.</p><a href={newhome.canonical_route+'#home-checklist'}>Use the new-homeowner checklist ↗</a></div>}{vip&&<div><h3>Give tune-ups a place on the calendar.</h3><p>Explore VIP Comfort Club, see what the furnace and AC tune-ups include, and compare the membership terms.</p><a class="button outline" href={vip.canonical_route}>Explore VIP Comfort Club <span aria-hidden="true">↗</span></a></div>}</div></div></div></section>
{!index&&<section class="section area-canvas"><div class="wrap"><div class="area-intro"><h2>{town} HVAC service questions.</h2></div><div class="area-faq">{content.faqs.map(faq=><details><summary>{faq.question}</summary><p>{faq.answer}</p></details>)}<details><summary>Where do I start if I do not know what is wrong?</summary><p>Choose the equipment you need help with, or share what you notice when you request service. You do not need to name a failed part.</p></details></div></div></section>}
<section class="section dark"><div class="wrap"><div class="area-intro"><h2>{index?'Let’s get your home back on track.':`Let’s get your ${town} home back on track.`}</h2><p>Tell us what changed, what you want to plan, or what you would like help caring for.</p></div><div class="area-story"><div><h3>Start with what matters at home.</h3><p>Share the address and your main concern. The office will confirm the visit details and what happens next.</p>{request&&<PrimaryActions dark href={request} label="Request service"/>}</div><Photo image={photo('close')} caption="Back to the moments that matter." tilt={-2}/></div><p class="area-disclosure">Town-inspired scenes are AI-generated illustrations, not photographs of actual properties, MGI customers, or completed work.</p></div></section>
</article>
<style>
.area-eyebrow{font:700 13px/1.5 Manrope,Arial,sans-serif;letter-spacing:.05em;text-transform:uppercase;color:var(--teal)}.area-small,.area-disclosure{font-size:13px;line-height:1.6;margin:22px 0 0}.area-intro{text-align:center;margin-bottom:40px}.area-intro h2,.area-intro p{max-width:none;width:100%}.area-story{display:grid;grid-template-columns:1fr 1fr;gap:72px;align-items:center}.area-story h3{font-size:29px;line-height:1.2}.area-service-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px}.area-service-card{border:1px solid #ffffff60;border-radius:14px;padding:24px;background:#103e49}.area-emergency-copy{font-size:14px;line-height:1.65}.area-service-card>summary{display:flex;gap:14px;align-items:center;margin-bottom:18px;list-style:none}.area-service-card>summary::-webkit-details-marker{display:none}.area-service-card :global(svg){width:32px;height:32px;flex:none;color:#b2c54f}.area-service-card h3{font-size:25px;margin:0}.area-service-card nav{display:flex;flex-direction:column}.area-service-card nav a{display:flex;justify-content:space-between;gap:12px;border-top:1px solid #ffffff35;min-height:44px;padding:12px 0;font-size:15px;text-decoration:none}.area-service-card nav a:hover{text-decoration:underline}.area-urgent{text-align:center;margin:28px 0 0;font-size:16px}.area-urgent a{display:inline-block;padding:8px 0;margin-left:8px}.area-needs{margin-top:60px}.area-decision-list>div{display:flex;gap:20px;border-bottom:1px solid #ffffff35;padding:22px 0}.area-decision-list h3{margin:0 0 10px}.area-decision-list p{font-size:16px;margin:0}.area-icon{width:64px;height:64px;background:#afc34f;border-radius:50%;display:grid;place-items:center;flex:none;color:var(--teal)}.area-icon :global(svg){width:32px;height:32px}.area-canvas{background:#f1f3ec}.area-local-note{border-left:3px solid #afc34f;padding:4px 0 4px 20px;margin:24px 0}.area-local-note h3{font-size:23px}.area-local-source,.area-resource-links a,.area-care a{display:inline-block;min-height:44px;padding:10px 0;font-size:15px;font-weight:700}.area-resource-links{display:flex;flex-wrap:wrap;gap:24px}.area-project ul{padding-left:22px}.area-project li{margin:10px 0}.area-care>div+div{border-top:1px solid #c4cbbc;margin-top:28px;padding-top:28px}.area-care .button{padding:14px 20px}.area-faq{max-width:850px;margin:auto}.area-faq details{border-top:1px solid #b9c4b2;padding:20px 0}.area-faq summary{font-size:18px;font-weight:700;cursor:pointer}.area-faq p{margin:18px 0 0}.area-disclosure{margin-top:48px}.area-map-wrap :global(.area-map-intro){display:block;text-align:center}.area-map-wrap :global(.area-map-intro h2),.area-map-wrap :global(.area-map-intro p){max-width:none}.area-standard :is(a,summary):focus-visible{outline:3px solid var(--teal);outline-offset:4px}.area-standard .dark :is(a,summary):focus-visible{outline-color:white}
@media(max-width:1050px){.area-service-grid{grid-template-columns:repeat(2,1fr)}.area-story{gap:40px}}
@media(max-width:767px){.area-story,.area-service-grid{grid-template-columns:1fr}.area-intro{margin-bottom:28px}.area-needs{margin-top:40px}.area-service-card{padding:18px 22px}.area-service-card>summary{margin:0;min-height:44px;cursor:pointer}.area-service-card>summary:after{content:"+";margin-left:auto;font:24px Arial}.area-service-card[open]>summary{margin-bottom:14px}.area-service-card[open]>summary:after{content:"−"}.area-story h3{font-size:27px}.area-icon{width:52px;height:52px}.area-decision-list>div{gap:16px}.area-resource-links{gap:14px}.area-map-wrap :global(.area-map-grid){grid-template-columns:1fr}}
</style>

<script>
const cards = document.querySelectorAll<HTMLDetailsElement>('.area-service-card');
const mobile = matchMedia('(max-width: 767px)');
function sizeServiceChoices() { cards.forEach(card => { card.open = !mobile.matches; }); }
sizeServiceChoices();
mobile.addEventListener('change', sizeServiceChoices);
</script>
