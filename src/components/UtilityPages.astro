---
import type {Route,Content} from '../data/types';import {byId} from '../data/catalog.mjs';import Eligibility from './Eligibility.astro';
import LandingCallMeasurement from './LandingCallMeasurement.astro';
interface Props {route:Route;content:Content;}
const {route,content}=Astro.props;const planner=route.page_id==='ST-009',missing=route.page_id==='ST-019';const links=(missing?['ST-005','ST-012','ST-003']:planner?['ST-008','ST-007','ST-003']:['ST-003','ST-014','ST-015','ST-016','ST-017']).filter(id=>id!==route.page_id).map(id=>byId(id)).filter(Boolean);
---
<article class="utility-page"><section class="hero"><div class="wrap"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">{route.name}</span></nav><div class="utility-opening"><p class="utility-label">{missing?'Page not found':planner?'Rebate planning':'Website information'}</p><h1>{content.title}</h1><p class="lede">{content.summary}</p></div></div></section><section class="section utility-body"><div class="wrap utility-grid"><div>{planner&&<Eligibility/>}{content.sections.map((section,i)=><>{route.page_id==='ST-014'&&i===3&&<section class="utility-section" id="text-messages"><h2>Text messages (SMS)</h2><p>If you choose to get texts from MGI Heating and Air, we use your mobile number to send appointment reminders, dispatch notices, service updates, offers and promotions. Opting in is optional and is not a condition of purchase.</p><p>No mobile information will be shared with third parties or affiliates for marketing or promotional purposes. Text message opt-in data and consent will not be sold or shared with any third parties, except the service providers that deliver our messages, such as ServiceTitan and mobile carriers.</p><p>Message frequency varies. Msg &amp; data rates may apply. Reply STOP to opt out at any time. Reply HELP for help or call MGI at (970) 287-1673. Read the <a href="/terms/#text-messages">text message terms</a>.</p></section>}<section class="utility-section" id={`detail-${i+1}`}><h2>{section.heading}</h2><p>{section.body}</p>{section.bullets&&<ul>{section.bullets.map(b=><li>{b}</li>)}</ul>}</section></>)}{route.page_id==='ST-015'&&<section class="utility-section" id="text-messages"><h2>Text message terms</h2><p><strong>Program.</strong> MGI Heating and Air text messages, sent by MGI Mechanical Services Inc, 266 Basher Dr Unit 1, Berthoud, CO 80513.</p><p><strong>What you get.</strong> Informational texts, such as appointment reminders, dispatch notices and service updates, and marketing texts, such as offers and promotions, at the mobile number you provide.</p><p><strong>How to join.</strong> Choose to get texts when you request service with MGI. Opting in is optional and is not a condition of purchase.</p><p><strong>Frequency and cost.</strong> Message frequency varies. Msg &amp; data rates may apply.</p><p><strong>Stop or get help.</strong> Reply STOP to opt out at any time. Reply HELP for help, or call MGI at (970) 287-1673.</p><p>Carriers are not liable for delayed or undelivered messages. Read how we handle your mobile number in our <a href="/privacy-policy/#text-messages">Privacy Policy</a>.</p></section>}{route.page_id==='ST-014'&&<p><a href="https://business.safety.google/privacy/">How Google uses information from this website</a></p>}{route.page_id==='ST-017'&&<LandingCallMeasurement choicesOnly sitewide/>}</div><aside><h2>{missing?'Find your next step.':planner?'Keep your options together.':'Related information'}</h2><nav aria-label="Related pages">{links.map(link=><a href={link!.canonical_route}>{link!.name} <span aria-hidden="true">↗</span></a>)}</nav>{planner&&<p class="small-copy">Your answers stay on this page. Nothing is sent to MGI.</p>}</aside></div></section></article>
<style>.utility-opening{max-width:900px}.utility-opening h1{font-size:clamp(38px,4vw,58px);max-width:none}.utility-label{font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:.06em}.utility-page .hero{padding-bottom:32px}.utility-body{padding-top:24px}.utility-grid{display:grid;grid-template-columns:minmax(0,2fr) minmax(240px,1fr);gap:72px;align-items:start}.utility-section{padding:24px 0;border-bottom:1px solid #c3cbc3}.utility-section h2{font-size:30px;max-width:none}.utility-grid aside{background:#f1f3ec;border-radius:14px;padding:26px}.utility-grid aside h2{font-size:27px}.utility-grid nav{display:grid}.utility-grid nav a{padding:16px 0;border-top:1px solid #c3cbc3;display:flex;justify-content:space-between;gap:20px}.utility-grid :global(.form-panel){margin-bottom:24px}@media(max-width:767px){.utility-grid{grid-template-columns:1fr;gap:32px}}</style>
