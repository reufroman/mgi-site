---
import config from '../data/landing-call-measurement.json';
import tagManager from '../data/tag-manager.json';
import { validateCallMeasurement } from '../data/landing-call-measurement.mjs';
interface Props { choicesOnly?: boolean; sitewide?: boolean; }
const { choicesOnly = false, sitewide = false } = Astro.props;
if (!choicesOnly && config.enabled && !validateCallMeasurement(config)) throw Error('Website call measurement requires verified configuration.');
---
<aside style="max-width:1200px;margin:0 auto;padding:12px 20px;border-bottom:1px solid #ccd5d7;font-size:14px" data-google-call-measurement data-config={JSON.stringify(config)} data-tag-manager={JSON.stringify(tagManager)} data-sitewide={String(sitewide)} data-choices-only={String(choicesOnly)} aria-label="Website measurement choices">
  <div data-call-measurement-controls style="display:flex;gap:16px;align-items:center;justify-content:space-between;flex-wrap:wrap"><p data-measurement-explanation style="margin:0;max-width:560px">May we use Google and ServiceTitan to measure visits and which ads lead to calls or service requests? You can call or request service either way.</p>
  <div style="display:flex;gap:12px;flex-wrap:wrap;align-items:center"><button class="button small outline" type="button" data-call-measurement-grant>Allow measurement</button><button class="button small outline" type="button" data-call-measurement-deny>Decline</button> <a href="/privacy-choices/">Privacy choices</a></div>
  </div><a data-change-privacy-choice href="/privacy-choices/" hidden>Change privacy choices</a><p style="margin:4px 0" data-call-measurement-status role="status" aria-live="polite"></p>
</aside>
<script>
  import { installCallMeasurement } from '../data/landing-call-measurement.mjs';
  import { installTagManager } from '../data/tag-manager.mjs';
  const CONSENT_UI_CSS = "[data-consent-actions] [data-call-measurement-grant]{order:-1;min-width:150px;font-weight:700}[data-consent-actions] [data-call-measurement-deny]{background:none;border:0;border-radius:4px;color:#174e5b;font:inherit;font-size:15px;font-weight:600;text-decoration:underline;text-underline-offset:3px;text-decoration-thickness:1.5px;min-height:44px;min-width:44px;padding:12px 8px;cursor:pointer;display:inline-flex;align-items:center;justify-content:center}[data-consent-actions] [data-call-measurement-deny]:hover{color:#103c46;text-decoration-thickness:2.5px}[data-consent-actions] [data-call-measurement-grant]:focus-visible,[data-consent-actions] [data-call-measurement-deny]:focus-visible{outline:3px solid #174e5b;outline-offset:2px}@media (max-width:767px){[data-call-measurement-controls]{gap:12px!important}[data-consent-actions]{width:100%;gap:10px!important}[data-consent-actions] [data-call-measurement-deny]{order:1;font-size:16px}[data-consent-actions]{justify-content:space-between}[data-consent-actions]>a{order:2;padding:12px 6px}[data-consent-actions] [data-call-measurement-grant]{order:3;flex:1 1 100%;min-height:52px;font-size:16px}}";
  const panel = document.querySelector<HTMLElement>('[data-google-call-measurement]');
  if (panel?.dataset.config) {
    const choicesOnly = panel.dataset.choicesOnly === 'true';
    const sitewide = panel.dataset.sitewide === 'true';
    // Consent banner UI (Reu, 2026-10-19): Accept all is the primary, easiest tap; Decline is an
    // underlined text link with a 44px tap area. Banner only; the choices-only Privacy Choices panel
    // keeps its prior look and labels. Consent logic, defaults, storage, GPC and tracking are unchanged.
    if (!choicesOnly) {
      try {
        const accept = panel.querySelector<HTMLButtonElement>('[data-call-measurement-grant]');
        if (accept) {
          accept.classList.remove('outline');
          panel.querySelector('[data-call-measurement-deny]')?.classList.remove('button', 'small', 'outline');
          accept.textContent = 'Accept all';
          accept.parentElement!.setAttribute('data-consent-actions', '');
          const style = document.createElement('style');
          style.setAttribute('data-mgi-consent-ui', '');
          style.textContent = CONSENT_UI_CSS;
          document.head.appendChild(style);
        }
      } catch {}
    }
    function onChange(choice: string = 'unset', state?: { basis: string; pending: boolean }) {
        const status = panel!.querySelector<HTMLElement>('[data-call-measurement-status]');
        const controls = panel!.querySelector<HTMLElement>('[data-call-measurement-controls]');
        const explanation = panel!.querySelector<HTMLElement>('[data-measurement-explanation]');
        const allow = panel!.querySelector<HTMLButtonElement>('[data-call-measurement-grant]');
        const decline = panel!.querySelector<HTMLButtonElement>('[data-call-measurement-deny]');
        const changeLink = panel!.querySelector<HTMLElement>('[data-change-privacy-choice]');
        if (state) panel!.dataset.measurementBasis = state.basis;
        panel!.dataset.measurementState = choice;
        const gpc = state?.basis === 'gpc';
        const on = choice === 'granted';
        // Saved Allow collapses the banner; the U.S. initial setting (on, not yet a saved choice) keeps both choices visible.
        const savedAllow = !choicesOnly && on && state?.basis === 'explicit-allow';
        const initialOn = on && state?.basis === 'colorado-opt-out-default';
        if (changeLink) changeLink.hidden = choice === 'unset' || choicesOnly || initialOn;
        if (controls) controls.hidden = !choicesOnly && (choice === 'denied' || savedAllow);
        if (allow) { allow.hidden = gpc || (on && !choicesOnly && !initialOn); allow.disabled = gpc; if (!choicesOnly) allow.textContent = 'Accept all'; }
        if (decline) decline.textContent = on && (choicesOnly || !initialOn) ? 'Turn measurement off' : 'Decline';
        if (explanation) explanation.textContent = on
          ? 'Website measurement is on. We use Google and ServiceTitan to understand visits and which ads lead to calls or service requests. You can turn measurement off and still call or request service.'
          : 'May we use Google and ServiceTitan to measure visits and which ads lead to calls or service requests? You can call or request service either way.';
        if (status) status.textContent = gpc ? 'Website measurement is off because your browser sent a privacy signal.'
          : on ? savedAllow ? 'Website measurement is on. You can change your choice in Privacy Choices.'
            : initialOn ? 'Choose Accept all to keep measurement on, or Decline to turn it off.'
            : 'Website measurement is on. You can turn it off below or in Privacy Choices.'
          : choice === 'denied' ? 'Website measurement is off. You can change your choice in Privacy Choices.'
          : state?.pending ? 'Website measurement is off while we check the initial setting for this visit.'
          : choicesOnly ? 'Website measurement is off until you choose Allow measurement.'
          : 'Website measurement is off until you choose Accept all.';
    }
    const callController = !sitewide ? installCallMeasurement(JSON.parse(panel.dataset.config), { window, document, choicesOnly, onChange }) : undefined;
    const manager = installTagManager(JSON.parse(panel.dataset.tagManager!), { window, document, choicesOnly, manageConsent: sitewide, reloadOnWithdrawal: sitewide, onChange: sitewide ? onChange : undefined });
    const controller = callController || manager;
    panel.querySelector('[data-call-measurement-grant]')?.addEventListener('click', () => controller.grant());
    panel.querySelector('[data-call-measurement-deny]')?.addEventListener('click', () => controller.deny());
  }
</script>
