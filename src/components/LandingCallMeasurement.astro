---
import config from '../data/landing-call-measurement.json';
import tagManager from '../data/tag-manager.json';
import { validateCallMeasurement } from '../data/landing-call-measurement.mjs';
interface Props { choicesOnly?: boolean; sitewide?: boolean; }
const { choicesOnly = false, sitewide = false } = Astro.props;
if (!choicesOnly && config.enabled && !validateCallMeasurement(config)) throw Error('Website call measurement requires verified configuration.');
---
<aside class:list={['measurement-panel', { 'measurement-drawer': !choicesOnly }]} hidden={!choicesOnly} data-google-call-measurement data-config={JSON.stringify(config)} data-tag-manager={JSON.stringify(tagManager)} data-sitewide={String(sitewide)} data-choices-only={String(choicesOnly)} aria-label="Website measurement choices">
  <div class="measurement-inner">
    <div data-call-measurement-controls class="measurement-controls">
      <p data-measurement-explanation>We use cookies and similar tools to understand how you use our website.</p>
      <div class="measurement-actions">
        <button class="measurement-allow" type="button" data-call-measurement-grant>Allow</button>
        <button class="measurement-link" type="button" data-call-measurement-deny>Decline</button>
        <a class="measurement-link" href="/privacy-choices/">Privacy choices</a>
      </div>
    </div>
    <p data-call-measurement-status role="status" aria-live="polite"></p>
  </div>
</aside>
<style>
  .measurement-panel { color: #183e43; background: #fff; font-size: 14px; line-height: 1.5; }
  .measurement-panel[hidden], .measurement-panel [hidden] { display: none !important; }
  .measurement-panel.measurement-drawer { margin: 0 !important; max-width: none !important; font-size: 14px !important; border-radius: 0; position: fixed; inset: auto 0 0; z-index: 10001; border-top: 1px solid #ccd5d7; box-shadow: 0 -8px 32px #183e4314; max-height: 70dvh; overflow-y: auto; padding-bottom: env(safe-area-inset-bottom); }
  .measurement-inner { max-width: 1200px; margin: 0 auto; padding: 20px 24px; }
  .measurement-controls { display: flex; align-items: center; justify-content: space-between; gap: 24px; }
  .measurement-controls p { margin: 0; max-width: 600px; font-size: inherit; }
  .measurement-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 20px; flex-shrink: 0; }
  .measurement-allow { border: 1px solid #183e43; border-radius: 4px; background: #183e43; color: #fff; padding: 12px 28px; min-height: 48px; cursor: pointer; font: inherit; font-weight: 700; }
  .measurement-allow:hover { background: #29565c; }
  .measurement-link { border: 0; border-radius: 0; padding: 12px 0; min-height: 48px; background: none; color: inherit; text-decoration: underline; text-underline-offset: 3px; font: inherit; cursor: pointer; display: inline-flex; align-items: center; }
  .measurement-actions :focus-visible { outline: 2px solid #183e43; outline-offset: 4px; }
  [data-call-measurement-status] { margin: 8px 0 0; font-size: inherit; }
  [data-call-measurement-status]:empty { display: none; }
  @media (max-width: 767px) { .measurement-controls { flex-direction: column; align-items: stretch; gap: 12px; } .measurement-inner { padding: 16px 20px; } .measurement-actions { gap: 8px 20px; } }
</style>
<script>
  import { installCallMeasurement } from '../data/landing-call-measurement.mjs';
  import { installTagManager } from '../data/tag-manager.mjs';
  const panel = document.querySelector<HTMLElement>('[data-google-call-measurement]');
  if (panel?.dataset.config) {
    const choicesOnly = panel.dataset.choicesOnly === 'true';
    const sitewide = panel.dataset.sitewide === 'true';
    function onChange(choice: string = 'unset', state?: { basis: string; pending: boolean }) {
        const status = panel!.querySelector<HTMLElement>('[data-call-measurement-status]');
        const controls = panel!.querySelector<HTMLElement>('[data-call-measurement-controls]');
        const explanation = panel!.querySelector<HTMLElement>('[data-measurement-explanation]');
        const allow = panel!.querySelector<HTMLButtonElement>('[data-call-measurement-grant]');
        const decline = panel!.querySelector<HTMLButtonElement>('[data-call-measurement-deny]');
        if (state) panel!.dataset.measurementBasis = state.basis;
        panel!.dataset.measurementState = choice;
        const gpc = state?.basis === 'gpc';
        const on = choice === 'granted';
        panel!.hidden = !choicesOnly && (choice !== 'unset' || !!state?.pending);
        if (controls) controls.hidden = !choicesOnly && choice === 'denied';
        if (allow) { allow.hidden = gpc || (on && !choicesOnly); allow.disabled = gpc; }
        if (decline) decline.textContent = on ? 'Turn measurement off' : 'Decline';
        if (explanation) explanation.textContent = on
          ? 'Website measurement is on. We use cookies and similar tools to understand how you use our website. You can turn measurement off in Privacy Choices.'
          : 'We use cookies and similar tools to understand how you use our website.';
        if (status) status.textContent = !choicesOnly ? '' : gpc ? 'Website measurement is off because your browser sent a privacy signal.'
          : on ? 'Website measurement is on. You can turn it off below or in Privacy Choices.'
          : choice === 'denied' ? 'Website measurement is off. You can change your choice in Privacy Choices.'
          : state?.pending ? 'Website measurement is off while we check the initial setting for this visit.'
          : 'Website measurement is off until you choose Allow.';
    }
    const callController = !sitewide ? installCallMeasurement(JSON.parse(panel.dataset.config), { window, document, choicesOnly, onChange }) : undefined;
    const manager = installTagManager(JSON.parse(panel.dataset.tagManager!), { window, document, choicesOnly, manageConsent: sitewide, reloadOnWithdrawal: sitewide, onChange: sitewide ? onChange : undefined });
    const controller = callController || manager;
    panel.querySelector('[data-call-measurement-grant]')?.addEventListener('click', () => controller.grant());
    panel.querySelector('[data-call-measurement-deny]')?.addEventListener('click', () => controller.deny());
  }
</script>
