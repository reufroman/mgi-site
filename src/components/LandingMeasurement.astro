---
import config from '../data/landing-conversions.json';
import { validateLandingConversions } from '../data/landing-conversions.mjs';
const validation = validateLandingConversions(config);
if (validation.enabled && !validation.valid) throw new Error(`Landing measurement activation blocked: ${validation.errors.join(' ')}`);
---
{validation.enabled && validation.valid && <aside data-landing-measurement data-config={JSON.stringify(config)} aria-label="Ad measurement choice">
  <p>May we use Google to measure this booking? You can use the scheduler either way.</p>
  <button type="button" data-measurement-grant>Allow ad measurement</button>
  <button type="button" data-measurement-deny>Decline ad measurement</button>
  <p data-measurement-status role="status"></p>
</aside>}
<script>
  import { installLandingMeasurement } from '../data/landing-conversions.mjs';
  const panel = document.querySelector<HTMLElement>('[data-landing-measurement]');
  if (panel?.dataset.config) {
    const controller = installLandingMeasurement(JSON.parse(panel.dataset.config), { window, document });
    if (controller.status === 'disabled') panel.hidden = true;
    else {
      const status = panel.querySelector<HTMLElement>('[data-measurement-status]');
      function showChoice() {
        if (status) status.textContent = controller.consent === 'granted' ? 'Ad measurement is allowed.' : controller.consent === 'denied' ? 'Ad measurement is declined.' : '';
      }
      panel.querySelector('[data-measurement-grant]')?.addEventListener('click', () => { controller.grant(); showChoice(); });
      panel.querySelector('[data-measurement-deny]')?.addEventListener('click', () => { controller.deny(); showChoice(); });
      showChoice();
    }
  }
</script>
<style>
  aside { margin: 2rem auto; padding: 1rem; max-width: 52rem; border: 1px solid #bcc8c0; border-radius: 12px; }
  button { font: inherit; padding: .65rem 1rem; margin: .5rem .5rem .5rem 0; cursor: pointer; }
  button:focus-visible { outline: 3px solid #005451; outline-offset: 3px; }
</style>
