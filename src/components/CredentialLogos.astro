---
import proof from '../data/home-proof.json';
interface Props {compact?:boolean;reviewHref?:string;excludeCarrierFactoryMark?:boolean;}
const {compact=false,excludeCarrierFactoryMark=false}=Astro.props;
const marks=[
 {src:'bbb.png',alt:'BBB Accredited, A+ rating',href:proof.bbb},
 {src:'mgi-carrier-300x298.png',alt:'Carrier Factory Authorized Dealer',href:proof.carrier},
 {src:'pres-award-mgi-logo.png',alt:'Carrier President’s Award',href:proof.carrier},
 {kind:'google',alt:`Google ${proof.googleRating}-star rating, ${proof.googleReviewCountLabel}`,href:proof.googleAggregateSource.primarySource},
 {src:'nate-mgi-logo.png',alt:'MGI employs NATE-certified technicians'},
 {src:'eebc-mgi-logo.png',alt:'EEBC member',href:proof.eebc}
].filter(mark=>!excludeCarrierFactoryMark || mark.src!=='mgi-carrier-300x298.png');
---
<div class:list={['credential-row','credential-standard',{'compact-credentials':compact}]} aria-label="Credentials, awards, and customer reviews">
 {marks.map(mark=>mark.kind==='google' ?
  <a href={mark.href} aria-label={mark.alt}>
   <span class="google-rating-mark" aria-hidden="true">
    <span class="google-rating-name">Google</span>
    <span class="google-rating-value">{proof.googleRating}<span class="google-rating-star">★</span></span>
    <span class="google-rating-count">{proof.googleReviewCountLabel}</span>
   </span>
  </a> : mark.href ?
  <a href={mark.href}><img src={'/assets/'+mark.src} alt={mark.alt} width="112" height="100" loading="lazy"/></a> :
  <div class="credential-logo"><img src={'/assets/'+mark.src} alt={mark.alt} width="112" height="100" loading="lazy"/></div>
 )}
</div>
<style>
 .google-rating-mark{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;width:112px;height:100px;background:var(--warm,#FFFDFB);color:var(--teal,#174E5B);font-family:Manrope,Arial,sans-serif;line-height:1.2;border:1px solid var(--teal,#174E5B);border-radius:4px}
 .google-rating-name{font-size:17px;font-weight:700;letter-spacing:-.02em}
 .google-rating-value{display:flex;align-items:center;gap:5px;font-size:26px;font-weight:700}
 .google-rating-star{font-size:18px}
 .google-rating-count{font-size:11px;font-weight:600}
 .compact-credentials .google-rating-mark{width:96px;height:96px}
 @media(max-width:767px){.google-rating-mark{width:96px;height:96px}}
</style>
